<UserControl xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="using:Cornerstone.MediaPlayer"
		mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
		x:Class="Cornerstone.MediaPlayer.Views.MainView"
		x:DataType="local:AppViewModel">
	<DockPanel>
		<Border DockPanel.Dock="Top"
				Classes="PlayerToolBar">
			<Grid ColumnDefinitions="*,Auto">
				<TextBox Classes="MediaUrl"
						Text="{Binding MediaUrl, Mode=TwoWay}"
						PlaceholderText="Media URL or local path" />
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
					<Button Content="Play sample" Command="{Binding PlaySampleCommand}" />
					<Button Content="Online" Command="{Binding UseOnlineSampleCommand}" />
					<Button Content="Open…" Click="OpenFileOnClick" />
					<Button Content="Play" Command="{Binding PlayCommand}" />
					<Button Content="Stop" Command="{Binding StopCommand}" />
				</StackPanel>
			</Grid>
		</Border>
		<TextBlock DockPanel.Dock="Bottom"
				Opacity="0.75"
				Text="{Binding StatusText}" />
		<MediaPlayerControl x:Name="Player" ShowMediaControls="True" />
	</DockPanel>
</UserControl>
