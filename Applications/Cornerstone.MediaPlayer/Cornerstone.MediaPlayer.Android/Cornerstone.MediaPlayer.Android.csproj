<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>27</SupportedOSPlatformVersion>
		<ApplicationId>com.bobbycannon.cornerstone.mediaplayer</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<IntermediateOutputPath>obj\a\$(Configuration)\</IntermediateOutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<AndroidResource Include="Icon.png">
			<Link>Resources\drawable\Icon.png</Link>
		</AndroidResource>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Cornerstone.MediaPlayer\Cornerstone.MediaPlayer.csproj" />
	</ItemGroup>
	<Import Project="..\..\..\Build\Presentation.props" />
</Project>
