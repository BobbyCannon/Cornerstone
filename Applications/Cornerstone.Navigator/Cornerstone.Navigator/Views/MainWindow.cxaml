<Window xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:views="using:Cornerstone.Navigator.Views"
		xmlns:local="using:Cornerstone.Navigator"
		mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
		x:Class="Cornerstone.Navigator.Views.MainWindow"
		x:DataType="local:AppViewModel"
		Icon="/Assets/Cornerstone.Navigator.ico"
		Width="1100" Height="700"
		Title="{Binding PageTitle}">
	<views:MainView />
</Window>