<UserControl xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="using:Cornerstone.Navigator"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Name="This"
		x:Class="Cornerstone.Navigator.Views.MainView"
		x:DataType="local:AppViewModel">
	<DockPanel>
		<Border DockPanel.Dock="Top"
				Classes="ToolBar NavigatorToolBar"
				BorderThickness="0,0,0,1">
			<Grid ColumnDefinitions="Auto,*,Auto">
				<StackPanel Orientation="Horizontal">
					<Button Classes="Icon"
							IsEnabled="{Binding CanGoBack}"
							Command="{Binding GoBackCommand}"
							ToolTip.Tip="Back">
						<PathIcon Data="{StaticResource Icons.Arrow.Left}" />
					</Button>
					<Button Classes="Icon"
							IsEnabled="{Binding CanGoForward}"
							Command="{Binding GoForwardCommand}"
							ToolTip.Tip="Forward">
						<PathIcon Data="{StaticResource Icons.Arrow.Right}" />
					</Button>
					<Button Classes="Icon"
							Command="{Binding ReloadCommand}"
							IsVisible="{Binding !IsNavigating}"
							ToolTip.Tip="Reload">
						<PathIcon Data="{StaticResource Icons.Refresh}" />
					</Button>
					<Button Classes="Icon"
							Command="{Binding StopCommand}"
							IsVisible="{Binding IsNavigating}"
							ToolTip.Tip="Stop">
						<PathIcon Data="{StaticResource Icons.Close}" />
					</Button>
					<Button Classes="Icon"
							Command="{Binding GoHomeCommand}"
							ToolTip.Tip="Home">
						<PathIcon Data="{StaticResource Icons.Home}"
								Height="20" Width="20"
								Margin="0,2,0,0" />
					</Button>
				</StackPanel>
				<TextBox Grid.Column="1"
						Classes="Location"
						Text="{Binding Address, Mode=TwoWay}"
						KeyDown="AddressOnKeyDown"
						PlaceholderText="Search or enter address" />
				<Button Grid.Column="2"
						Classes="Icon"
						Command="{Binding OpenFavoriteEditorCommand}"
						ToolTip.Tip="Favorites">
					<Grid>
						<PathIcon Data="{StaticResource Icons.Star.Outline}"
								IsVisible="{Binding !IsFavorite}" />
						<PathIcon Data="{StaticResource Icons.Star}"
								IsVisible="{Binding IsFavorite}" />
					</Grid>
				</Button>
			</Grid>
		</Border>
		<Border DockPanel.Dock="Top"
				Classes="PersonalToolbar"
				IsVisible="{Binding HasFavorites}">
			<ItemsControl ItemsSource="{Binding Favorites}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="local:BrowserFavorite">
						<Button Theme.Color="None"
								Padding="8,4"
								MaxWidth="140"
								Command="{Binding DataContext.NavigateFavoriteCommand, ElementName=This}"
								CommandParameter="{Binding}">
							<Button.ContextMenu>
								<ContextMenu>
									<MenuItem Header="Edit"
											ItemsSource="{x:Null}"
											Command="{Binding DataContext.EditFavoriteCommand, ElementName=This}"
											CommandParameter="{Binding}"
											ContextMenu="{x:Null}" />
									<MenuItem Header="Remove"
											ItemsSource="{x:Null}"
											Command="{Binding DataContext.RemoveFavoriteCommand, ElementName=This}"
											CommandParameter="{Binding}"
											ContextMenu="{x:Null}" />
								</ContextMenu>
							</Button.ContextMenu>
							<TextBlock Text="{Binding Name}"
									TextTrimming="CharacterEllipsis"
									Opacity="0.85" />
						</Button>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Border>
		<Border DockPanel.Dock="Bottom"
				Classes="StatusBar NavigatorStatusBar">
			<Grid ColumnDefinitions="Auto,*,Auto">
				<StackPanel Orientation="Horizontal">
					<Path Data="{StaticResource Icons.Lock}"
							Width="14"
							Height="14"
							Margin="8,2,0,0"
							IsVisible="{Binding IsSecure}"
							Opacity="0.8" />
					<TextBlock Classes="Label"
							Text="{Binding SecurityText}" />
					<TextBlock Classes="Value"
							Text="{Binding LocationHost}"
							Opacity="0.8" />
				</StackPanel>
				<TextBlock Grid.Column="1"
						Classes="Value"
						Text="{Binding StatusText}"
						VerticalAlignment="Center"
						Margin="12,0,0,0" />
				<ProgressBar Grid.Column="2"
						Classes="DocumentProgress"
						IsIndeterminate="{Binding IsNavigating}"
						Maximum="100" />
			</Grid>
		</Border>
		<Grid>
			<Grid x:Name="WebViewHost" />
			<Grid IsVisible="{Binding IsFavoriteEditorOpen}">
				<Border Background="{DynamicResource Background09}"
						Opacity="0.35"
						PointerPressed="FavoriteScrimOnPointerPressed" />
				<Border Background="{DynamicResource Background02}"
						CornerRadius="8"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Width="420"
						Padding="14">
					<StackPanel Spacing="8">
						<TextBlock Text="Favorite"
								Opacity="0.7" />
						<TextBlock Text="Name"
								Classes="InputName" />
						<TextBox Text="{Binding EditorName, Mode=TwoWay}" />
						<TextBlock Text="Uri"
								Classes="InputName" />
						<TextBox Text="{Binding EditorUri, Mode=TwoWay}" />
						<Button Theme.Color="None"
								Command="{Binding SaveFavoriteCommand}"
								Content="Save"
								Margin="0,6,0,0" />
						<Button Theme.Color="None"
								Command="{Binding CloseFavoriteEditorCommand}"
								Content="Cancel" />
					</StackPanel>
				</Border>
			</Grid>
		</Grid>
	</DockPanel>
</UserControl>
