<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net10.0-windows10.0.26100.0</TargetFrameworks>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>$(MSBuildThisFileDirectory)Assets/Cornerstone.GrokMonitor.ico</ApplicationIcon>
	</PropertyGroup>
	<ItemGroup>
		<CornerstoneXaml Include="**\*.cxaml" Exclude="bin\**;obj\**;**\*.xproj;packages\**" />
		<CornerstoneResource Include="Assets\**" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\Cornerstone.Presentation.Diagnostics\Cornerstone.Presentation.Diagnostics.csproj" />
		<ProjectReference Include="..\..\Cornerstone\Cornerstone.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- PublicKey matches Cornerstone.snk used by Directory.Build.props -->
		<InternalsVisibleTo Include="Cornerstone.UnitTests, " />
	</ItemGroup>
	<Import Project="..\..\Build\Presentation.props" />
</Project>

