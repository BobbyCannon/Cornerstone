<Window xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:Cornerstone.RemoteLink"
		xmlns:airPlay="clr-namespace:Cornerstone.RemoteLink.AirPlay"
		xmlns:android="clr-namespace:Cornerstone.RemoteLink.Android"
		xmlns:vnc="clr-namespace:Cornerstone.RemoteLink.Vnc"
		mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="700"
		x:Class="Cornerstone.RemoteLink.AppWindow"
		x:DataType="local:AppViewModel"
		x:Name="This"
		Icon="/Assets/Cornerstone.RemoteLink.ico"
		Title="Cornerstone RemoteLink"
		MainMenu="{Binding ElementName=This, Path=MainMenu}">
	<Window.InnerRightContent>
		<StackPanel Orientation="Horizontal">
			<Button Classes="Dim"
					Theme.Color="None"
					BorderThickness="0"
					Command="{Binding ToggleThemeModeCommand}"
					ToolTip.Tip="Toggle Theme">
				<PathIcon Height="16" Width="16"
						Data="{Binding ElementName=This, Path=ActualThemeVariant, Converter={x:Static ThemeConverters.ToThemeIconInverted}}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center" />
			</Button>
		</StackPanel>
	</Window.InnerRightContent>
	<TabControl ItemsSource="{Binding ShellTabs}"
			SelectedItem="{Binding SelectedShellTab}">
		<TabControl.ItemTemplate>
			<DataTemplate x:DataType="local:IShellTab">
				<TextBlock Text="{Binding DisplayName}" />
			</DataTemplate>
		</TabControl.ItemTemplate>
		<TabControl.DataTemplates>
			<DataTemplate DataType="airPlay:AirPlayTabViewModel">
				<airPlay:AirPlayTabView />
			</DataTemplate>
			<DataTemplate DataType="android:AndroidTabViewModel">
				<android:AndroidTabView />
			</DataTemplate>
			<DataTemplate DataType="vnc:VncTabViewModel">
				<vnc:VncTabView />
			</DataTemplate>
		</TabControl.DataTemplates>
	</TabControl>
</Window>
