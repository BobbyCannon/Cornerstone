<CornerstoneWindow xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:agent="clr-namespace:Cornerstone.Agent"
		xmlns:views="clr-namespace:Cornerstone.Agent.Views"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="Cornerstone.Agent.AppWindow"
		x:DataType="agent:AppViewModel"
		x:Name="This"
		Icon="/Assets/Cornerstone.Agent.ico"
		Title="Cornerstone Agent"
		MainMenu="{Binding ElementName=This, Path=MainMenu}">
	<CornerstoneWindow.InnerRightContent>
		<StackPanel Orientation="Horizontal">
			<Button Classes="Dim"
					Theme.Color="None"
					BorderThickness="0"
					Command="{x:Static CornerstoneTheme.ToggleThemeCommand}"
					ToolTip.Tip="Toggle Theme"
					>
				<PathIcon Height="16" Width="16"
						Data="{Binding ElementName=This, Path=ActualThemeVariant, Converter={x:Static ThemeConverters.ToThemeIconInverted}}"
						HorizontalAlignment="Center"
						VerticalAlignment="Center" />
			</Button>
			<Button Classes="Dim"
					Theme.Color="None"
					BorderThickness="0"
					Command="{Binding SelectViewCommand}"
					CommandParameter="{x:Static views:SettingsViewModel.AssemblyName}"
					ToolTip.Tip="Settings">
				<Path Data="{StaticResource Icons.Cog}"
						Height="14" Width="14" />
			</Button>
		</StackPanel>
	</CornerstoneWindow.InnerRightContent>
	<ContentControl Content="{Binding CurrentViewModel}" />
</CornerstoneWindow>