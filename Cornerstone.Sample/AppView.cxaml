<UserControl xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:sample="clr-namespace:Cornerstone.Sample"
		xmlns:converters="clr-namespace:Cornerstone.Presentation.Theme.Converters;assembly=Cornerstone.Presentation"
		mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
		Background="{DynamicResource Background02}"
		x:Class="Cornerstone.Sample.AppView"
		x:DataType="sample:AppViewModel"
		x:Name="This">
	<Grid>
		<Image Source="/Assets/Cornerstone.png"
				HorizontalAlignment="Left"
				VerticalAlignment="Bottom"
				Height="256"
				Width="256"
				Opacity="0.05"
				Margin="40" />
		<NavigationMenu x:Name="Menu"
				AutoExpandOnResize="{Binding NavigationMenuAutoExpandOnResize, Mode=TwoWay}"
				AutoCollapseOnSelectionChange="{Binding NavigationMenuAutoCollapseOnSelectionChange, Mode=TwoWay}"
				DisplayMode="{Binding NavigationMenuDisplayMode, Mode=TwoWay}"
				IsOpen="{Binding NavigationMenuIsOpen, Mode=TwoWay}"
				ItemsSource="{Binding Tabs}"
				SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
			<NavigationMenu.PaneBackground>
				<SolidColorBrush Color="{DynamicResource Background03}" Opacity="0.90" />
			</NavigationMenu.PaneBackground>
			<NavigationMenu.DataTemplates>
				<ViewLocator />
			</NavigationMenu.DataTemplates>
			<NavigationMenu.ItemTemplate>
				<DataTemplate x:DataType="TabItemReferenceViewModel">
					<StackPanel Orientation="Horizontal">
						<Path Data="{Binding TabIcon, Converter={x:Static converters:ResourceConverters.GetSvg}}"
								Height="16" Width="16"
								Margin="{Binding TabIconMargin}" />
						<TextBlock Text="{Binding TabName}"
								Margin="14,0,0,0" />
					</StackPanel>
				</DataTemplate>
			</NavigationMenu.ItemTemplate>
			<FlyoutBase.AttachedFlyout>
				<Flyout>
					<StackPanel MinWidth="220" Spacing="10" Margin="14">
						<TextBlock Text="Menu" Opacity="0.9" />
						<ComboBox HorizontalAlignment="Stretch"
								SelectedItem="{Binding #Menu.DisplayMode, Mode=TwoWay}">
							<ComboBox.Items>
								<SplitViewDisplayMode>CompactInline</SplitViewDisplayMode>
								<SplitViewDisplayMode>CompactOverlay</SplitViewDisplayMode>
								<SplitViewDisplayMode>Inline</SplitViewDisplayMode>
								<SplitViewDisplayMode>Overlay</SplitViewDisplayMode>
							</ComboBox.Items>
						</ComboBox>
						<ToggleSwitch
								IsChecked="{Binding #Menu.IsOpen, Mode=TwoWay}"
								OnContent="IsOpen"
								OffContent="IsOpen" />
						<ToggleSwitch
								IsChecked="{Binding #Menu.AutoCollapseOnSelectionChange, Mode=TwoWay}"
								OnContent="Auto Collapse On Change"
								OffContent="Auto Collapse On Change" />
						<ToggleSwitch
								IsChecked="{Binding #Menu.AutoExpandOnResize, Mode=TwoWay}"
								OnContent="Auto Expand On Resize"
								OffContent="Auto Expand On Resize" />
					</StackPanel>
				</Flyout>
			</FlyoutBase.AttachedFlyout>
		</NavigationMenu>
		<BrowserThreads />
	</Grid>
</UserControl>
