<UserControl
		xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:tabs="clr-namespace:Cornerstone.Sample.Tabs.Observe"
		mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1032"
		x:Class="Cornerstone.Sample.Tabs.Observe.TabProfiler"
		x:DataType="tabs:TabProfiler"
		x:Name="This">
	<DockPanel>
		<Grid DockPanel.Dock="Top" Margin="10,14,10,6">
			<TextBlock Classes="Header"
					HorizontalAlignment="Center"
					Text="{x:Static tabs:TabProfiler.HeaderName}" />
		</Grid>
		<Border Classes="StatusBar"
				CornerRadius="0"
				DockPanel.Dock="Bottom"
				IsVisible="{Binding HasStartupProfile}">
			<Grid>
				<StackPanel>
					<Button Classes="Icon"
							Command="{Binding ExpandStartupProfileCommand}"
							ToolTip.Tip="Expand All">
						<Path Data="{StaticResource Icons.DoubleDown}"
								Height="14" Width="14"
								Margin="2,0,0,0" />
					</Button>
					<Button Classes="Icon"
							Command="{Binding CollapseStartupProfileCommand}"
							ToolTip.Tip="Collapse All">
						<Path Data="{StaticResource Icons.DoubleUp}"
								Height="14" Width="14"
								Margin="2,0,0,0"/>
					</Button>
				</StackPanel>
				<StackPanel Spacing="10">
					<Button Classes="Hyperlink"
							Command="{Binding CopyStartupProfileCommand}"
							Content="Copy" />
					<ComboBox MinWidth="120"
							VerticalAlignment="Center"
							ItemsSource="{Binding StartupProfileFilterOptions}"
							SelectedItem="{Binding StartupProfileFilter}" />
					<Button Classes="Hyperlink"
							Command="{Binding CopyStartupProfileAllCommand}"
							Content="Copy all" />
				</StackPanel>
				<StackPanel></StackPanel>
			</Grid>
		</Border>
		<TextBlock Margin="16"
				Opacity="0.75"
				TextWrapping="Wrap"
				IsVisible="{Binding !HasStartupProfile}"
				Text="{Binding EmptyMessage}" />
		<TreeDataGrid ItemsSource="{Binding StartupProfile}"
				ShowColumnHeaders="True"
				IsVisible="{Binding HasStartupProfile}" />
	</DockPanel>
</UserControl>
