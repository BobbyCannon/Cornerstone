<UserControl
		xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:tabs="clr-namespace:Cornerstone.Sample.Tabs.Inputs"
		xmlns:input="clr-namespace:Cornerstone.Input;assembly=Cornerstone"
		mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="720"
		x:Class="Cornerstone.Sample.Tabs.Inputs.TabInputsGamepad"
		x:DataType="tabs:TabInputsGamepad">
	<DockPanel>
		<Grid DockPanel.Dock="Top" Margin="10,14,10,6">
			<TextBlock Classes="Header"
					HorizontalAlignment="Center"
					Text="{x:Static tabs:TabInputsGamepad.HeaderName}" />
		</Grid>
		<WrapPanel DockPanel.Dock="Top"
				Margin="16,0,16,8"
				ItemSpacing="16"
				LineSpacing="8">
			<ToggleSwitch
					OnContent="Monitor"
					OffContent="Monitor"
					IsChecked="{Binding MonitorGamepads, Mode=TwoWay}" />
			<Button Theme.Color="None"
					Content="Clear"
					Command="{Binding ClearHistoryCommand}" />
		</WrapPanel>
		<ScrollViewer>
			<StackPanel Margin="16,0,16,20" Spacing="20">
				<ItemsControl ItemsSource="{Binding GamepadsManager.Gamepads}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="20" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="input:Gamepad">
							<Border Background="{DynamicResource Background03}"
									BorderBrush="{DynamicResource Background06}"
									BorderThickness="1"
									CornerRadius="12"
									Padding="16">
								<StackPanel Spacing="10">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<TextBlock Text="Gamepad" />
										<TextBlock Text="{Binding State.Index}" />
										<TextBlock Text="Connected" IsVisible="{Binding State.IsConnected}" />
										<TextBlock Text="Disconnected" Opacity="0.65" IsVisible="{Binding !State.IsConnected}" />
									</StackPanel>
									<GamepadView Gamepad="{Binding State}" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<Border Background="{DynamicResource Background03}"
						BorderBrush="{DynamicResource Background06}"
						BorderThickness="1"
						CornerRadius="12"
						Padding="16">
					<DockPanel>
						<TextBlock DockPanel.Dock="Top" Text="History" Margin="0,0,0,8" />
						<ListBox ItemsSource="{Binding GamepadHistory}" MaxHeight="220">
							<ListBox.ItemTemplate>
								<DataTemplate DataType="input:GamepadState">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<TextBlock Text="{Binding DateTime, StringFormat='{}{0:HH:mm:ss.fff}'}" />
										<TextBlock Text="{Binding Index}" />
										<TextBlock Text="{Binding Buttons}" />
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</DockPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</UserControl>
