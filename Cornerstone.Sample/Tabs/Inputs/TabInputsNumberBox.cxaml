<UserControl
		xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:tabs="clr-namespace:Cornerstone.Sample.Tabs.Inputs"
		mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="720"
		x:Class="Cornerstone.Sample.Tabs.Inputs.TabInputsNumberBox"
		x:DataType="tabs:TabInputsNumberBox">
	<DockPanel>
		<Grid DockPanel.Dock="Top" Margin="10,14,10,6">
			<TextBlock Classes="Header"
					HorizontalAlignment="Center"
					Text="{x:Static tabs:TabInputsNumberBox.HeaderName}" />
		</Grid>
		<ScrollViewer HorizontalScrollBarVisibility="Disabled">
			<PreviewCodeSnippet>
				<StackPanel Spacing="16">
					<TextBlock Classes="Header" Text="NumberBox" />
					<ItemsControl ItemsSource="{x:Static Theme.ThemeColors}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel ItemSpacing="10" LineSpacing="10" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="ThemeColor">
								<StackPanel Spacing="4">
									<NumberBox Theme.Color="{Binding}"
											MinWidth="120" />
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</PreviewCodeSnippet>
		</ScrollViewer>
	</DockPanel>
</UserControl>
