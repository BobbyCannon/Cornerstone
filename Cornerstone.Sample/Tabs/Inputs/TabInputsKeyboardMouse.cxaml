<UserControl
		xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:tabs="clr-namespace:Cornerstone.Sample.Tabs.Inputs"
		xmlns:input="clr-namespace:Cornerstone.Input;assembly=Cornerstone"
		mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="720"
		x:Class="Cornerstone.Sample.Tabs.Inputs.TabInputsKeyboardMouse"
		x:DataType="tabs:TabInputsKeyboardMouse">
	<DockPanel>
		<Grid DockPanel.Dock="Top" Margin="10,14,10,6">
			<TextBlock Classes="Header"
					HorizontalAlignment="Center"
					Text="{x:Static tabs:TabInputsKeyboardMouse.HeaderName}" />
		</Grid>
		<WrapPanel DockPanel.Dock="Top"
				Margin="16,0,16,8"
				ItemSpacing="16"
				LineSpacing="8">
			<ToggleSwitch
					OnContent="Keyboard"
					OffContent="Keyboard"
					IsChecked="{Binding MonitorKeyboard, Mode=TwoWay}" />
			<ToggleSwitch
					OnContent="Mouse"
					OffContent="Mouse"
					IsChecked="{Binding MonitorMouse, Mode=TwoWay}" />
			<CheckBox
					Content="Move"
					IsChecked="{Binding MonitorMouseMove, Mode=TwoWay}"
					IsEnabled="{Binding MonitorMouse}" />
			<Button Theme.Color="None"
					Content="Clear"
					Command="{Binding ClearHistoryCommand}" />
		</WrapPanel>
		<ScrollViewer>
			<StackPanel Margin="16,0,16,20" Spacing="16">
				<Border Background="{DynamicResource Background03}"
						BorderBrush="{DynamicResource Background06}"
						BorderThickness="1"
						CornerRadius="12"
						Padding="16">
					<DockPanel>
						<TextBlock DockPanel.Dock="Top" Text="Keyboard" Margin="0,0,0,8" />
						<ListBox ItemsSource="{Binding KeyboardHistory}" MaxHeight="200">
							<ListBox.ItemTemplate>
								<DataTemplate DataType="input:KeyboardStateArg">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<TextBlock Text="{Binding DateTime, StringFormat='{}{0:HH:mm:ss.fff}'}" />
										<TextBlock Text="{Binding Event}" />
										<TextBlock Text="{Binding Key}" />
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</DockPanel>
				</Border>
				<Border Background="{DynamicResource Background03}"
						BorderBrush="{DynamicResource Background06}"
						BorderThickness="1"
						CornerRadius="12"
						Padding="16">
					<DockPanel>
						<TextBlock DockPanel.Dock="Top" Text="Mouse" Margin="0,0,0,8" />
						<ListBox ItemsSource="{Binding MouseHistory}" MaxHeight="200">
							<ListBox.ItemTemplate>
								<DataTemplate DataType="input:MouseState">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<TextBlock Text="{Binding DateTime, StringFormat='{}{0:HH:mm:ss.fff}'}" />
										<TextBlock Text="{Binding Event}" />
										<TextBlock Text="{Binding X}" />
										<TextBlock Text="{Binding Y}" />
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</DockPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</UserControl>
