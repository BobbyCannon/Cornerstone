<UserControl
		xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:tabs="clr-namespace:Cornerstone.Sample.Tabs.Welcome"
		xmlns:themes="clr-namespace:Cornerstone.Presentation.Theme.Theming;assembly=Cornerstone.Presentation"
		mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="640"
		x:Class="Cornerstone.Sample.Tabs.Welcome.TabThemes"
		x:DataType="tabs:TabThemes"
		x:Name="This">
	<!-- Theme triad: Color · Mode · Density — persists via AppSettings. -->
	<DockPanel>
		<ScrollViewer HorizontalScrollBarVisibility="Disabled">
			<StackPanel Margin="16,8,16,20" Spacing="16" MaxWidth="560" HorizontalAlignment="Center">
				<TextBlock Opacity="0.7"
						TextWrapping="Wrap"
						Text="Choose color, light/dark mode, and UI density. Values save with the sample app and apply through CornerstoneTheme (same pattern as real products)." />

				<!-- Mode -->
				<Border Background="{DynamicResource Background03}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="8"
						Padding="14">
					<StackPanel Spacing="10">
						<TextBlock Text="Mode" Opacity="0.9" />
						<ComboBox Width="220"
								HorizontalAlignment="Left"
								ItemsSource="{x:Static themes:Theme.ThemeModes}"
								SelectedItem="{Binding Settings.ThemeMode, Mode=TwoWay}" />
					</StackPanel>
				</Border>

				<!-- Density + live sample (above Color so token changes are visible before accent chrome) -->
				<Border Background="{DynamicResource Background03}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="8"
						Padding="14">
					<StackPanel Spacing="10">
						<TextBlock Text="Density" Opacity="0.9" />
						<ComboBox Width="220"
								HorizontalAlignment="Left"
								ItemsSource="{x:Static themes:Theme.ThemeDensities}"
								SelectedItem="{Binding Settings.ThemeDensity, Mode=TwoWay}" />
						<TextBlock Opacity="0.65"
								TextWrapping="Wrap"
								Text="Compact / Normal / Large scale the three tokens from Theme.Constants.cxaml. Use DynamicResource so this sample updates live." />
						<StackPanel Spacing="6">
							<TextBlock Opacity="0.65"
									FontSize="{DynamicResource ControlFontSizeSmall}"
									Text="ControlFontSizeLarge" />
							<TextBlock FontSize="{DynamicResource ControlFontSizeLarge}"
									TextWrapping="Wrap"
									Text="The quick brown fox jumps over the lazy dog." />
							<TextBlock Opacity="0.65"
									FontSize="{DynamicResource ControlFontSizeSmall}"
									Text="ControlFontSize" />
							<TextBlock FontSize="{DynamicResource ControlFontSize}"
									TextWrapping="Wrap"
									Text="The quick brown fox jumps over the lazy dog." />
							<TextBlock Opacity="0.65"
									FontSize="{DynamicResource ControlFontSizeSmall}"
									Text="ControlFontSizeSmall" />
							<TextBlock FontSize="{DynamicResource ControlFontSizeSmall}"
									Opacity="0.7"
									TextWrapping="Wrap"
									Text="The quick brown fox jumps over the lazy dog." />
						</StackPanel>
					</StackPanel>
				</Border>

				<!-- Color -->
				<Border Background="{DynamicResource Background03}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="8"
						Padding="14">
					<StackPanel Spacing="10">
						<TextBlock Text="Color" Opacity="0.9" />
						<ComboBox Width="220"
								HorizontalAlignment="Left"
								ItemsSource="{x:Static themes:Theme.Colors}"
								SelectedItem="{Binding Settings.ThemeColor, Mode=TwoWay}" />
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button Theme.Color="None" Content="None" MinWidth="80" />
							<Button Theme.Color="Current" Content="Current" MinWidth="80" />
							<ToggleButton Content="Accent" IsChecked="True" MinWidth="80" />
						</StackPanel>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</UserControl>