<UserControl
		xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:tabs="clr-namespace:Cornerstone.Sample.Tabs.Media"
		mc:Ignorable="d" d:DesignWidth="600"
		x:Class="Cornerstone.Sample.Tabs.Media.TabWebView"
		x:DataType="tabs:TabWebView">
	<DockPanel>
		<WrapPanel DockPanel.Dock="Top"
				ItemSpacing="20"
				LineSpacing="10"
				Margin="10">
			<TextBox MinWidth="240" Text="{Binding Uri}">
				<TextBox.KeyBindings>
					<KeyBinding Gesture="Enter" Command="{Binding RefreshCommand}" />
				</TextBox.KeyBindings>
			</TextBox>
			<CheckBox Content="Is Visible"
					IsChecked="{Binding ElementName=WebView, Path=IsVisible}" />
			<CheckBox x:Name="ShowDemoOverlayCheckBox"
					Content="Show overlay"
					IsChecked="False" />
		</WrapPanel>
		<!-- Place Cornerstone siblings after WebView so they paint over the live page. -->
		<Grid>
			<WebView x:Name="WebView" />
			<Border x:Name="DemoOverlay"
					Background="#CC1E1E1E"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Padding="24"
					CornerRadius="8"
					MaxWidth="360"
					IsVisible="{Binding #ShowDemoOverlayCheckBox.IsChecked}">
				<StackPanel Spacing="8">
					<TextBlock Text="Composed overlay"
							FontSize="{DynamicResource ControlFontSize}"
							HorizontalAlignment="Center" />
					<TextBlock Text="WebView renders native web content. Other controls in this layout are composed on top of that output, so Cornerstone UI can sit over the page without replacing it."
							TextWrapping="Wrap"
							Opacity="0.85" />
					<ToggleButton Content="Close"
							HorizontalAlignment="Center"
							IsChecked="{Binding !#ShowDemoOverlayCheckBox.IsChecked, Mode=TwoWay}" />
				</StackPanel>
			</Border>
		</Grid>
	</DockPanel>
</UserControl>