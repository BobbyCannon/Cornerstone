<UserControl
		xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:tabs="clr-namespace:Cornerstone.Sample.Tabs.Media"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
		x:Class="Cornerstone.Sample.Tabs.Media.TabCamera"
		x:DataType="tabs:TabCamera">
	<DockPanel>
		<WrapPanel DockPanel.Dock="Top"
				ItemSpacing="12"
				LineSpacing="8"
				Margin="10">
			<Button Content="Start preview"
					Command="{Binding StartPreviewCommand}" />
			<Button Content="Stop preview"
					Command="{Binding StopPreviewCommand}" />
			<Button Content="Start record"
					Command="{Binding StartRecordCommand}" />
			<Button Content="Stop record"
					Command="{Binding StopRecordCommand}" />
			<ComboBox MinWidth="120"
					ItemsSource="{Binding #Camera.AvailableModes}"
					SelectedItem="{Binding #Camera.Mode, Mode=TwoWay}" />
			<CheckBox x:Name="ShowDemoOverlayCheckBox"
					Content="Show overlay"
					IsChecked="False" />
			<TextBlock VerticalAlignment="Center"
					Opacity="0.75"
					Text="{Binding StatusText}" />
		</WrapPanel>
		<TextBlock DockPanel.Dock="Top"
				Margin="10,0,10,8"
				Opacity="0.65"
				TextWrapping="Wrap"
				Text="Preview and record are separate. Start preview first, then start record (writes a temp MP4). Recording continues if it was already in progress." />
		<!-- Place Cornerstone siblings after CameraView so they can paint over live native. -->
		<Grid>
			<Border Background="{DynamicResource Background02}" />
			<CameraView x:Name="Camera" />
			<Border x:Name="DemoOverlay"
					Background="#CC1E1E1E"
					IsVisible="{Binding #ShowDemoOverlayCheckBox.IsChecked}"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Padding="24"
					CornerRadius="8"
					MaxWidth="360">
				<StackPanel Spacing="8">
					<TextBlock Text="Composed overlay"
							FontSize="{DynamicResource ControlFontSize}"
							HorizontalAlignment="Center" />
					<TextBlock Text="CameraView renders native camera preview. Other controls in this layout are composed on top of that output, so Cornerstone UI can sit over the picture without replacing it."
							TextWrapping="Wrap"
							Opacity="0.85" />
					<ToggleButton Content="Close"
							HorizontalAlignment="Center"
							IsChecked="{Binding !#ShowDemoOverlayCheckBox.IsChecked, Mode=TwoWay}" />
				</StackPanel>
			</Border>
		</Grid>
	</DockPanel>
</UserControl>