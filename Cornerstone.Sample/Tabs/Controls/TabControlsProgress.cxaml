<UserControl
		xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:tabs="clr-namespace:Cornerstone.Sample.Tabs.Controls"
		xmlns:c="clr-namespace:Cornerstone.Presentation.Theme.Converters;assembly=Cornerstone.Presentation"
		mc:Ignorable="d" d:DesignWidth="690" d:DesignHeight="800"
		x:Class="Cornerstone.Sample.Tabs.Controls.TabControlsProgress"
		x:DataType="tabs:TabControlsProgress">
	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
		<PreviewCodeSnippet>
			<StackPanel Spacing="16">
				<TextBlock Classes="Header" Text="Circular" />
				<WrapPanel ItemSpacing="10"
						LineSpacing="10"
						Orientation="Horizontal">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Text="Value:"
								VerticalAlignment="Center" />
						<TextBlock Text="{Binding ElementName=Value, Path=Value}"
								VerticalAlignment="Center" />
						<Slider x:Name="Value"
								Value="25"
								Width="160" />
					</StackPanel>
					<CheckBox x:Name="ShowProgressText" Content="Show Progress Text" />
					<CheckBox x:Name="Indeterminate" Content="Indeterminate" />
				</WrapPanel>
				<ItemsControl ItemsSource="{x:Static Theme.ThemeColors}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel ItemSpacing="10" LineSpacing="10" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="ThemeColor">
							<CircularProgress Theme.Color="{Binding}"
									IsIndeterminate="{Binding ElementName=Indeterminate, Path=IsChecked}"
									ShowProgressText="{Binding ElementName=ShowProgressText, Path=IsChecked}"
									Value="{Binding ElementName=Value, Path=Value}"
									Content="{Binding}" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<TextBlock Classes="Header" Text="Linear" />
				<WrapPanel ItemSpacing="10"
						LineSpacing="10">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Text="Height:"
								Width="50"
								VerticalAlignment="Center" />
						<TextBlock Text="{Binding #Progress.Height, Converter={x:Static c:Converters.Format}, ConverterParameter=0}"
								Width="20"
								VerticalAlignment="Center" />
						<Slider ControlHelper.DisplayName="Height"
								Value="{Binding #Progress.Height}"
								Width="160" />
					</StackPanel>
					<StackPanel Orientation="Horizontal" Spacing="8">
						<TextBlock Text="Value:"
								Width="40"
								VerticalAlignment="Center" />
						<TextBlock Text="{Binding #Progress.Value, Converter={x:Static c:Converters.Format}, ConverterParameter=0}"
								Width="20"
								VerticalAlignment="Center" />
						<Slider ControlHelper.DisplayName="Value"
								Value="{Binding #Progress.Value}"
								Maximum="{Binding #Progress.Maximum}"
								Minimum="{Binding #Progress.Minimum}"
								Width="160" />
					</StackPanel>
					<NumericUpDown
							ControlHelper.DisplayName="Indeterminate"
							Increment="100"
							FormatString="0"
							HorizontalAlignment="Stretch"
							InnerRightContent="ms"
							Value="{Binding #Progress.IndeterminateDuration, Converter={StaticResource TimeSpanConverter}, ConverterParameter=ms}" />
					<CheckBox IsChecked="{Binding #Progress.ShowProgressText, Mode=TwoWay}"
							Content="Show Progress Text" />
					<CheckBox IsChecked="{Binding #Progress.IsIndeterminate, Mode=TwoWay}"
							Content="Indeterminate" />
				</WrapPanel>
				<Grid IsVisible="False">
					<ProgressBar x:Name="Progress"
							Theme.Color="Current"
							IsIndeterminate="{Binding #Progress.IsIndeterminate}"
							ShowProgressText="{Binding #Progress.ShowProgressText}"
							Value="10"
							Minimum="0"
							Maximum="100"
							Height="15" />
				</Grid>
				<ItemsControl ItemsSource="{x:Static Theme.ThemeColors}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<UniformGrid ColumnSpacing="10"
									Columns="1"
									RowSpacing="10"
									VerticalAlignment="Top" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="ThemeColor">
							<Grid>
								<ProgressBar Theme.Color="{Binding}"
										IsIndeterminate="{Binding #Progress.IsIndeterminate}"
										IndeterminateDuration="{Binding #Progress.IndeterminateDuration}"
										ShowProgressText="{Binding #Progress.ShowProgressText}"
										Value="{Binding #Progress.Value}"
										Minimum="{Binding #Progress.Minimum}"
										Maximum="{Binding #Progress.Maximum}"
										Height="{Binding #Progress.Height}" />
								<TextBlock Text="{Binding}"
										Margin="10,0,0,0"
										IsVisible="{Binding #Progress.ShowProgressText}"
										VerticalAlignment="Center" />
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</PreviewCodeSnippet>
	</ScrollViewer>
</UserControl>
