<UserControl
		xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:tabs="clr-namespace:Cornerstone.Sample.Tabs.Controls"
		mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
		x:Class="Cornerstone.Sample.Tabs.Controls.TabDockingManager"
		x:DataType="tabs:TabDockingManager">
	<DockPanel>
		<Grid DockPanel.Dock="Top" Margin="10">
			<TextBlock Classes="Header"
					HorizontalAlignment="Center"
					Text="Docking Manager" />
		</Grid>
		<ContentControl
				Content="{Binding DockingManager}"
				Margin="-1,0,-1,-1" />
	</DockPanel>
</UserControl>