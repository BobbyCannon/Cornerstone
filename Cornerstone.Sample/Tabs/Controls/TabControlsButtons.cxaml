<UserControl
		xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="800"
		x:Class="Cornerstone.Sample.Tabs.Controls.TabControlsButtons"
		x:Name="This">
	<UserControl.Resources>
		<MenuFlyout x:Key="SharedMenuFlyout"
				Placement="BottomEdgeAlignedLeft">
			<MenuItem Header="Item 1">
				<MenuItem Header="Subitem 1" />
				<MenuItem Header="Subitem 2" />
				<MenuItem Header="Subitem 3" />
			</MenuItem>
			<MenuItem Header="Item 2" InputGesture="Ctrl+A" />
			<MenuItem Header="Item 3" />
		</MenuFlyout>
	</UserControl.Resources>
	<UserControl.Styles>
		<Style Selector="Button.StandardPreview">
			<Setter Property="Width" Value="160" />
		</Style>
		<Style Selector="ToggleButton.TogglePreview">
			<Setter Property="Width" Value="160" />
		</Style>
		<Style Selector="ToggleButton.ToggleText">
			<Setter Property="Content" Value="Indeterminate" />
		</Style>
		<Style Selector="ToggleButton.ToggleText[IsChecked=True]">
			<Setter Property="Content" Value="Checked" />
		</Style>
		<Style Selector="ToggleButton.ToggleText[IsChecked=False]">
			<Setter Property="Content" Value="Unchecked" />
		</Style>
		<Style Selector="DropDownButton.DropDownPreview">
			<Setter Property="Width" Value="160" />
		</Style>
	</UserControl.Styles>
	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
		<PreviewCodeSnippet>
			<StackPanel Spacing="16">
				<TextBlock Classes="Header" Text="Press Hold" />
				<WrapPanel ItemSpacing="10" LineSpacing="10">
					<NumericUpDown
							ControlHelper.DisplayName="Duration (MS)"
							FormatString="000"
							Increment="100"
							Value="{Binding ElementName=HoldButton, Path=HoldDuration, Converter={StaticResource TimeSpanConverter}, ConverterParameter=ms}" />
					<!-- Height/Width are double (NaN when unset). NumericUpDown.Value is decimal.
					     Without a safe converter, Cornerstone's ToDecimal(NaN) throws OverflowException. -->
					<NumericUpDown
							ControlHelper.DisplayName="Height (px)"
							FormatString="00"
							Increment="1"
							Value="{Binding ElementName=HoldButton, Path=Height, Converter={StaticResource DoubleToDecimalConverter}}" />
					<NumericUpDown
							ControlHelper.DisplayName="Width (px)"
							FormatString="00"
							Increment="10"
							Value="{Binding ElementName=HoldButton, Path=Width, Converter={StaticResource DoubleToDecimalConverter}}" />
					<ComboBox SelectedValue="{Binding ElementName=HoldButton, Path=Orientation, Mode=TwoWay}"
							SelectedValueBinding="{Binding Content, DataType=ComboBoxItem}"
							ControlHelper.DisplayName="Orientation:">
						<ComboBoxItem>
							<Orientation>Horizontal</Orientation>
						</ComboBoxItem>
						<ComboBoxItem>
							<Orientation>Vertical</Orientation>
						</ComboBoxItem>
					</ComboBox>
					<CheckBox Content="Enabled"
							IsChecked="{Binding ElementName=HoldButton, Path=IsEnabled, Mode=TwoWay}" />
					<PressHoldButton
							x:Name="HoldButton"
							Content="Press"
							HoldCommand="{Binding ElementName=This, Path=ButtonCommand}"
							HoldCommandParameter="Press"
							Height="32"
							HoldDuration="00:00:01"
							IsVisible="False"
							Orientation="Horizontal"
							Width="120" />
					<PressHoldButton Classes="Flat">Flat</PressHoldButton>
				</WrapPanel>
				<ItemsControl ItemsSource="{x:Static Theme.ThemeColors}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel ItemSpacing="10" LineSpacing="10" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="ThemeColor">
							<PressHoldButton
									Content="{Binding}"
									HoldCommand="{Binding ElementName=This, Path=ButtonCommand}"
									HoldCommandParameter="{Binding}"
									Height="{Binding ElementName=HoldButton, Path=Height}"
									HoldDuration="{Binding ElementName=HoldButton, Path=HoldDuration}"
									IsEnabled="{Binding ElementName=HoldButton, Path=IsEnabled}"
									Orientation="{Binding ElementName=HoldButton, Path=Orientation}"
									Theme.Color="{Binding}"
									Width="{Binding ElementName=HoldButton, Path=Width}" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<TextBlock Classes="Header" Text="Standard" />
				<WrapPanel Orientation="Horizontal"
						ItemSpacing="10"
						LineSpacing="10">
					<CheckBox x:Name="ButtonIsEnable" IsChecked="True" Content="Enabled" />
					<TextBlock Text="Width"
							Margin="20,0,0,0"
							VerticalAlignment="Center" />
					<Slider x:Name="ButtonWidth"
							ControlHelper.DisplayName="Width"
							Minimum="120"
							Maximum="300"
							Value="100"
							Width="160"
							TickFrequency="10" />
					<TextBlock Text="{Binding ElementName=ButtonWidth, Path=Value}"
							VerticalAlignment="Center" />
				</WrapPanel>
				<ItemsControl ItemsSource="{x:Static Theme.ThemeColors}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel ItemSpacing="10" LineSpacing="10" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="ThemeColor">
							<Button Classes="StandardPreview"
									Theme.Color="{Binding}"
									Content="{Binding}"
									IsEnabled="{Binding ElementName=ButtonIsEnable, Path=IsChecked}"
									Width="{Binding ElementName=ButtonWidth, Path=Value}" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<TextBlock Classes="Header" Text="Toggle" />
				<ItemsControl ItemsSource="{x:Static Theme.ThemeColors}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel ItemSpacing="10" LineSpacing="10" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="ThemeColor">
							<StackPanel Spacing="6">
								<ToggleButton
										x:Name="ToggleButton"
										Classes="TogglePreview ToggleText"
										Theme.Color="{Binding}"
										IsChecked="True"
										IsThreeState="True" />
								<ToggleButton
										Classes="TogglePreview"
										Content="{Binding #ToggleButton.Content}"
										Theme.Color="{Binding}"
										IsChecked="{Binding #ToggleButton.IsChecked}"
										IsEnabled="False"
										IsThreeState="True" />
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<TextBlock Classes="Header" Text="DropDownButton" />
				<ItemsControl ItemsSource="{x:Static Theme.ThemeColors}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel ItemSpacing="10" LineSpacing="10" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="ThemeColor">
							<StackPanel Spacing="6">
								<DropDownButton
										Classes="DropDownPreview"
										Theme.Color="{Binding}"
										Content="{Binding}"
										Flyout="{StaticResource SharedMenuFlyout}" />
								<DropDownButton
										Classes="DropDownPreview"
										Theme.Color="{Binding}"
										Content="(Disabled)"
										IsEnabled="False"
										Flyout="{StaticResource SharedMenuFlyout}" />
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</PreviewCodeSnippet>
	</ScrollViewer>
</UserControl>
