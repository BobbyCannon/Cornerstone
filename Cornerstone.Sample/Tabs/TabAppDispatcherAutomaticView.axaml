<UserControl
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:tabs="clr-namespace:Cornerstone.Sample.Tabs"
		mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
		x:Class="Cornerstone.Sample.Tabs.TabAppDispatcherAutomaticView"
		x:DataType="tabs:TabAppDispatcherAutomaticViewModel"
		x:Name="This"
		HorizontalAlignment="Stretch"
		VerticalAlignment="Stretch">
	<!-- ReSharper disable Xaml.MissingGridIndex -->
	<Grid RowDefinitions="*,Auto">
		<Grid.Styles>
			<Style Selector="Button">
				<Setter Property="MinWidth" Value="70" />
			</Style>
		</Grid.Styles>
		<Border Grid.Row="0"
				BorderThickness="1"
				Padding="4"
				ClipToBounds="True">
			<ScrollViewer HorizontalScrollBarVisibility="Disabled"
					VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<AutoGrid
							Classes="Input"
							ColumnDefinitions="*,*"
							RowCount="8"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Top">
						<AutoGrid.Styles>
							<Style Selector="TextBlock.InputName">
								<Setter Property="Foreground" Value="{StaticResource Orange05}" />
							</Style>
						</AutoGrid.Styles>
						<TextBlock Grid.ColumnSpan="2"
								Classes="Header"
								Text="Model (Off Dispatcher)"
								TextAlignment="Center" />
						<TextBlock Classes="InputName" Text="Model" />
						<TextBlock Classes="InputValue" x:Name="ModelValue" Text="0" />
						<TextBlock Grid.ColumnSpan="2"
								Foreground="{DynamicResource Foreground09}"
								Text="Updated Off Dispatcher — shown for reference"
								TextAlignment="Center" />
						<TextBlock Grid.ColumnSpan="2"
								Classes="Header"
								Text="ViewModel (On Dispatcher)"
								TextAlignment="Center" />
						<TextBlock Grid.ColumnSpan="2"
								Foreground="{DynamicResource Foreground09}"
								Text="Bound On Dispatcher for reference"
								TextAlignment="Center" />
						<TextBlock Classes="InputName" Text="Is Attached" />
						<TextBlock Classes="InputValue" Text="{Binding Projection.IsAttached}" />
						<TextBlock Classes="InputName" Text="Number" />
						<TextBlock Classes="InputValue" Text="{Binding Projection.Number}" />
					</AutoGrid>
					<GroupBox
							Header="View for ViewModel"
							HorizontalAlignment="Center"
							Margin="20,10"
							Padding="20,0">
						<Grid>
							<ContentControl
									Content="{Binding AttachedProjection}"
									HorizontalAlignment="Center"
									Margin="0,20,0,0">
								<ContentControl.ContentTemplate>
									<DataTemplate DataType="tabs:TabAppDispatcherTestViewModel">
										<tabs:TabAppDispatcherTestView ViewModel="{Binding}"
												DataContext="{Binding}" />
									</DataTemplate>
								</ContentControl.ContentTemplate>
							</ContentControl>
							<TextBlock
									Foreground="{DynamicResource Foreground09}"
									Text="ViewModel is not attached, no View available"
									TextAlignment="Center"
									Margin="0,10"
									IsVisible="{Binding AttachedProjection, Converter={x:Static ObjectConverters.IsNull}}" />
						</Grid>
					</GroupBox>
					<TextBlock Foreground="{DynamicResource Foreground09}"
							Text="ViewModel will refresh once when attached if the Model was updated while detached"
							TextAlignment="Center"
							TextWrapping="Wrap"
							Margin="10,0,10,10"
							Width="300" />
				</StackPanel>
			</ScrollViewer>
		</Border>
		<Border Grid.Row="1"
				BorderThickness="1"
				Padding="10">
			<WrapPanel ItemSpacing="10">
				<Button Click="UpdateOnceOnClick">Update Once</Button>
				<Button Click="UpdateManyOnClick">Update Many</Button>
				<Button Click="AttachViewOnClick">Attach View</Button>
				<Button Click="DetachViewOnClick">Detach View</Button>
			</WrapPanel>
		</Border>
	</Grid>
</UserControl>