<CornerstoneApplication xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="Cornerstone.Sample.App">
	<CornerstoneApplication.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="csres://Cornerstone.Presentation/Theming/Icons.cxaml" />
				<ResourceInclude Source="Themes/Icons.cxaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</CornerstoneApplication.Resources>
	<CornerstoneApplication.Styles>
		<CornerstoneTheme
				ThemeColor="Blue"
				ThemeMode="Default"
				ThemeDensity="Normal" />
		<StyleInclude Source="Themes/HomeCards.cxaml" />
	</CornerstoneApplication.Styles>
</CornerstoneApplication>