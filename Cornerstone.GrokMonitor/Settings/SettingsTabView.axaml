<UserControl xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:settings="clr-namespace:Cornerstone.GrokMonitor.Settings"
		xmlns:themes="clr-namespace:Cornerstone.Avalonia.Themes;assembly=Cornerstone.Avalonia"
		mc:Ignorable="d" d:DesignWidth="1032"
		x:Class="Cornerstone.GrokMonitor.Settings.SettingsTabView"
		x:DataType="settings:SettingsTabViewModel">
	<DockPanel>
		<Grid DockPanel.Dock="Top" Margin="10,14,10,6">
			<TextBlock Classes="Header"
					HorizontalAlignment="Center"
					Text="Settings" />
		</Grid>
		<ScrollViewer HorizontalScrollBarVisibility="Disabled">
			<ResponsiveGrid ColumnSpacing="16"
					RowSpacing="16"
					Margin="16,8,16,20">
				<ResponsiveGrid.Styles>
					<Style Selector="Border.Card">
						<Setter Property="Background" Value="{DynamicResource Background03}" />
						<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
						<Setter Property="BorderThickness" Value="1" />
						<Setter Property="CornerRadius" Value="8" />
						<Setter Property="Padding" Value="14" />
						<Setter Property="ResponsiveGrid.XS" Value="24" />
						<Setter Property="ResponsiveGrid.SM" Value="12" />
						<Setter Property="ResponsiveGrid.MD" Value="6" />
					</Style>
					<Style Selector="ComboBox.Setting">
						<Setter Property="HorizontalAlignment" Value="Left" />
						<Setter Property="Width" Value="200" />
					</Style>
				</ResponsiveGrid.Styles>
				<TextBlock Opacity="0.7"
						HorizontalAlignment="Center"
						TextWrapping="Wrap"
						Text="Appearance preferences for Grok Monitor. Theme mode Default follows the system light/dark setting."
						ResponsiveGrid.XS="24" />

				<Border Classes="Card">
					<StackPanel Spacing="12">
						<TextBlock Text="Theme color" Opacity="0.9" />
						<ComboBox Classes="Setting"
								ItemsSource="{x:Static themes:Theme.Colors}"
								SelectedItem="{Binding ThemeColor, Mode=TwoWay}" />
						<TextBlock Opacity="0.65"
								TextWrapping="Wrap"
								Text="Sample chart and progress use the current accent so color changes show immediately." />

						<StackPanel Spacing="4">
							<TextBlock Text="Sample graph"
									FontSize="{DynamicResource ControlFontSizeSmall}"
									Opacity="0.7" />
							<LineChart Title=""
									Theme.Color="{Binding ThemeColor}"
									Data="{Binding ColorSampleChartData}"
									Stepped="True"
									Height="100"
									ShowLabels="False"
									RelativeScale="False" />
						</StackPanel>

						<StackPanel Spacing="8">
							<TextBlock Text="Sample progress"
									FontSize="{DynamicResource ControlFontSizeSmall}"
									Opacity="0.7" />
							<LinearProgress Theme.Color="{Binding ThemeColor}"
									Value="{Binding SampleProgressValue}"
									Minimum="0"
									Maximum="100"
									Height="14"
									ShowProgressText="True" />
							<WrapPanel Orientation="Horizontal"
									ItemSpacing="10"
									LineSpacing="10">
								<Button Theme.Color="{Binding ThemeColor}" Content="Accent" MinWidth="80" />
								<ToggleButton Content="Toggle" IsChecked="True" MinWidth="80" />
							</WrapPanel>
						</StackPanel>
					</StackPanel>
				</Border>

				<Border Classes="Card">
					<StackPanel Spacing="10">
						<TextBlock Text="Theme density" Opacity="0.9" />
						<ComboBox Classes="Setting"
								ItemsSource="{x:Static themes:Theme.ThemeDensities}"
								SelectedItem="{Binding ThemeDensity, Mode=TwoWay}" />
						<TextBlock Opacity="0.65"
								TextWrapping="Wrap"
								Text="Compact, Normal, or Large. Lists and chrome that use ControlFontSize update live." />
						<TextBlock Text="Primary (ControlFontSize) — The quick brown fox jumps over the lazy dog."
								FontSize="{DynamicResource ControlFontSize}"
								TextWrapping="Wrap" />
						<TextBlock Text="Secondary (ControlFontSizeSmall) — muted captions and metadata use this token."
								FontSize="{DynamicResource ControlFontSizeSmall}"
								Opacity="0.7"
								TextWrapping="Wrap" />
					</StackPanel>
				</Border>

				<Border Classes="Card">
					<StackPanel Spacing="10">
						<TextBlock Text="Theme variant" Opacity="0.9" />
						<ComboBox Classes="Setting"
								ItemsSource="{x:Static themes:Theme.ThemeModes}"
								SelectedItem="{Binding ThemeMode, Mode=TwoWay}" />
						<TextBlock Opacity="0.65"
								TextWrapping="Wrap"
								Text="Dark, Light, or Default (system)." />
					</StackPanel>
				</Border>

				<Border Classes="Card">
					<StackPanel Spacing="10">
						<TextBlock Text="Sessions heat" Opacity="0.9" />
						<CheckBox Content="Tint session rows by total tokens"
								IsChecked="{Binding SessionTokenHeatEnabled, Mode=TwoWay}" />
						<TextBlock Opacity="0.65"
								TextWrapping="Wrap"
								Text="Row tint goes from yellow at the soft total to red at the hot total. Sessions below soft stay untinted. Defaults: 1,000,000 soft · 10,000,000 hot." />
						<ResponsiveGrid
								ColumnSpacing="10"
								RowSpacing="10"
								Thresholds="400,600,800">
							<ResponsiveGrid.Styles>
								<Style Selector="StackPanel.CardValue">
									<Setter Property="Spacing" Value="4" />
									<Setter Property="ResponsiveGrid.XS" Value="24" />
									<Setter Property="ResponsiveGrid.SM" Value="12" />
								</Style>
							</ResponsiveGrid.Styles>
							<StackPanel Classes="CardValue">
								<TextBlock Text="Soft total (tokens)"
										FontSize="{DynamicResource ControlFontSizeSmall}"
										Opacity="0.7" />
								<NumericUpDown Minimum="0"
										Maximum="100000000000"
										Increment="100000"
										FormatString="N0"
										HorizontalAlignment="Stretch"
										Value="{Binding SessionTokenHeatSoftTokens, Mode=TwoWay}" />
							</StackPanel>
							<StackPanel Classes="CardValue">
								<TextBlock Text="Hot total (tokens)"
										FontSize="{DynamicResource ControlFontSizeSmall}"
										Opacity="0.7" />
								<NumericUpDown
										Minimum="1"
										Maximum="10000000"
										Increment="100000"
										FormatString="N0"
										HorizontalAlignment="Stretch"
										Value="{Binding SessionTokenHeatHotTokens, Mode=TwoWay}" />
							</StackPanel>
						</ResponsiveGrid>
						<TextBlock Opacity="0.65"
								TextWrapping="Wrap"
								Text="Hot must be greater than soft. Invalid pairs are corrected automatically." />

					</StackPanel>
				</Border>
			</ResponsiveGrid>
		</ScrollViewer>
	</DockPanel>
</UserControl>