<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<!-- AOT -->
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
		<PublishAot>true</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>full</TrimMode>
		<IsAotCompatible>true</IsAotCompatible>
		<!-- Native AOT cannot infer a RID from RuntimeIdentifiers (plural) alone, nor for portable net TFMs. -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(TargetFramework)' != '' and ($(TargetFramework.Contains('-windows')) or !$(TargetFramework.Contains('-')))">win-x64</RuntimeIdentifier>
		<SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
		<!-- Reduce build noise -->
		<IlcVerbose>false</IlcVerbose>
		<IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<PublishAot>false</PublishAot>
	</PropertyGroup>
	<ItemGroup>
		<!-- If you modify this update R2R -->
		<TrimmerRootAssembly Include="Cornerstone" RootMode="all" />
		<TrimmerRootAssembly Include="Cornerstone.EntityFramework" RootMode="all" />
		<TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore" RootMode="all" />
		<TrimmerRootAssembly Include="Microsoft.EntityFrameworkCore.Sqlite" RootMode="library" />
		<TrimmerRootAssembly Include="Microsoft.Web.WebView2.Core" RootMode="all" />
		<TrimmerRootAssembly Include="Microsoft.Web.WebView2.WinForms" RootMode="all" />
		<TrimmerRootAssembly Include="Microsoft.Web.WebView2.Wpf" RootMode="all" />
		<TrimmerRootNamespace Include="Cornerstone" />
		<TrimmerRootNamespace Include="Cornerstone.EntityFramework" />
		<TrimmerRootNamespace Include="Microsoft.Web.WebView2" />
	</ItemGroup>
	<!-- ILC fails if a TrimmerRootAssembly is not part of the compilation (e.g. Presentation tests have no EF). -->
	<Target Name="RemoveUnreferencedTrimmerRootAssemblies" AfterTargets="ResolveAssemblyReferences">
		<ItemGroup>
			<_ReferencedAssemblyFileNames Include="@(ReferencePath->'%(FileName)')" />
			<_ReferencedAssemblyFileNames Include="$(AssemblyName)" />
			<_UnreferencedTrimmerRootAssemblies Include="@(TrimmerRootAssembly)" Exclude="@(_ReferencedAssemblyFileNames)" />
			<TrimmerRootAssembly Remove="@(_UnreferencedTrimmerRootAssemblies)" />
		</ItemGroup>
	</Target>
</Project>