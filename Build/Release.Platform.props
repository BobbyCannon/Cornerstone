<?xml version="1.0" encoding="utf-8"?>

<Project>
	<!-- Platform detection -->
	<PropertyGroup>
		<_IsAndroid>false</_IsAndroid>
		<_IsAndroid Condition="$(TargetFramework.Contains('android')) or $(RuntimeIdentifier.Contains('android'))">true</_IsAndroid>

		<_IsiOS>false</_IsiOS>
		<_IsiOS Condition="$(TargetFramework.Contains('ios')) or $(RuntimeIdentifier.Contains('ios'))">true</_IsiOS>

		<_IsBrowser>false</_IsBrowser>
		<_IsBrowser Condition="$(TargetFramework.Contains('browser')) or $(RuntimeIdentifier.Contains('browser'))">true</_IsBrowser>

		<!-- ASP.NET Core websites (Sdk="Microsoft.NET.Sdk.Web") must not use desktop single-file R2R publish -->
		<_IsWeb>false</_IsWeb>
		<_IsWeb Condition="'$(UsingMicrosoftNETSdkWeb)' == 'true'">true</_IsWeb>

		<_IsMacCatalyst Condition="$(TargetFramework.Contains('maccatalyst'))">true</_IsMacCatalyst>

		<!-- Desktop single-file R2R is for apps only. Libraries must stay RID-less or restore has no netX/win-x64 graph. -->
		<_IsApp>false</_IsApp>
		<_IsApp Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">true</_IsApp>

		<_SupportsR2R>true</_SupportsR2R>
		<_SupportsR2R Condition="'$(_IsAndroid)' == 'true' or '$(_IsiOS)' == 'true' or '$(_IsBrowser)' == 'true' or '$(_IsWeb)' == 'true' or '$(_IsApp)' != 'true' or !$(TargetFramework.Contains('-windows'))">false</_SupportsR2R>

		<!-- Native AOT is net (Core) only. Command-line EnableAot=true still flows to
		     netstandard analyzers/build tasks; they must not import PublishAot. -->
		<_SupportsAot>false</_SupportsAot>
		<_SupportsAot Condition="$(TargetFramework.StartsWith('net'))
			and !$(TargetFramework.StartsWith('netstandard'))
			and !$(TargetFramework.StartsWith('net4'))">true</_SupportsAot>
	</PropertyGroup>

	<!-- Platform-specific Release settings -->
	<Import Project="$(MSBuildThisFileDirectory)Release.Android.props"
			Condition="'$(_IsAndroid)' == 'true'" />

	<Import Project="$(MSBuildThisFileDirectory)Release.iOS.props"
			Condition="'$(_IsiOS)' == 'true'" />

	<Import Project="$(MSBuildThisFileDirectory)Release.Browser.props"
			Condition="'$(_IsBrowser)' == 'true'" />

	<!-- ASP.NET Core websites: R2R for startup, no single-file -->
	<Import Project="$(MSBuildThisFileDirectory)Release.Web.props"
			Condition="'$(_IsWeb)' == 'true'
                     and '$(EnableAot)' != 'true'" />

	<!-- AOT has highest priority, but only on TFMs that support Native AOT -->
	<Import Project="$(MSBuildThisFileDirectory)Release.Aot.props"
			Condition="'$(EnableAot)' == 'true' and '$(_SupportsAot)' == 'true'" />

	<!-- Desktop R2R (single-file) only on supported platforms + Release + AOT not requested -->
	<Import Project="$(MSBuildThisFileDirectory)Release.R2R.props"
			Condition="'$(Configuration)' == 'Release'
                     and '$(EnableAot)' != 'true'
                     and '$(_SupportsR2R)' == 'true'" />
</Project>