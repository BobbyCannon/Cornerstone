<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
	<PropertyGroup>
		<TargetFrameworks>net10.0-browser</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PublishAot>false</PublishAot>
		<PublishTrimmed>false</PublishTrimmed>
		<TrimMode>none</TrimMode>
		<StackTraceSupport>true</StackTraceSupport>
		<DebuggerSupport>true</DebuggerSupport>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\Cornerstone.Sample\Cornerstone.Sample.csproj" />
	</ItemGroup>
	<Target Name="CopyFiles" AfterTargets="Build">
		<Copy SourceFiles="$(ProjectDir)..\Cornerstone.Presentation\Platforms\Browser\Cornerstone.Browser.css"
				DestinationFiles="$(ProjectDir)wwwroot\css\Cornerstone.Browser.css" />
		<Copy SourceFiles="$(ProjectDir)..\Cornerstone.Presentation\Platforms\Browser\Cornerstone.Browser.js"
				DestinationFiles="$(ProjectDir)wwwroot\Cornerstone.Browser.js" />
	</Target>
	<Import Project="..\Build\Presentation.props" />
</Project>