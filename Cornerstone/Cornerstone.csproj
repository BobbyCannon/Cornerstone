<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-android;net10.0-browser;net10.0-ios;net10.0-windows10.0.26100.0</TargetFrameworks>
		<SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">35</SupportedOSPlatformVersion>
		<AssemblyTitle>Cornerstone</AssemblyTitle>
		<PackageId>Cornerstone</PackageId>
		<SignAssembly>true</SignAssembly>
	</PropertyGroup>
	<Import Project="..\Package.props" />
	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeCornerstoneGeneratorsInPackage</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="Platforms\**" />
		<None Include="Platforms\**" />
		<Compile Include="Platforms\*.cs" />
		<EmbeddedResource Include="Resources\**" />
	</ItemGroup>
	<ItemGroup>
		<Compile Include="..\Cornerstone.Generators\Reflection\*.cs" LinkBase="Reflection" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
		<PackageReference Include="NuGet.Frameworks" Version="7.9.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.90" />
		<Compile Include="Platforms\Android\**\*.cs" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browser'">
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.90" />
		<Compile Include="Platforms\Browser\**\*.cs" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.90" />
		<Compile Include="Platforms\iOS\**\*.cs" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.26100.0'">
		<Compile Include="Platforms\Windows\**\*.cs" />
		<PackageReference Include="System.Management" Version="10.0.11" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Cornerstone.Automation, " />
		<InternalsVisibleTo Include="Cornerstone.Presentation, " />
		<InternalsVisibleTo Include="Cornerstone.Presentation.UnitTests, " />
		<InternalsVisibleTo Include="Cornerstone.UnitTests, " />
	</ItemGroup>
	<Target Name="IncludeCornerstoneGeneratorsInPackage" Condition="'$(TargetFramework)' == 'net10.0'">
		<PropertyGroup>
			<_CornerstoneGeneratorsDll>$(MSBuildThisFileDirectory)..\Cornerstone.Generators\bin\$(Configuration)\netstandard2.0\Cornerstone.Generators.dll</_CornerstoneGeneratorsDll>
		</PropertyGroup>
		<Error Condition="!Exists('$(_CornerstoneGeneratorsDll)')" Text="Cornerstone.Generators.dll was not found at $(_CornerstoneGeneratorsDll). Build Cornerstone.Generators first." />
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(_CornerstoneGeneratorsDll)">
				<PackagePath>analyzers/dotnet/cs/Cornerstone.Generators.dll</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>
</Project>