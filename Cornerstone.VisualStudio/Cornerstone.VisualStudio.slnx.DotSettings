	<s:String x:Key="/Default/PatternsAndTemplates/LiveTemplates/Template/=8F438E5F6F10144089187FA0881C2451/Text/@EntryValue">private bool UpdateEntity($entity$ update, $entity$ entity, Action processUpdate, SyncObjectStatus status)&#xD;
{&#xD;
	switch (status)&#xD;
	{&#xD;
		case SyncObjectStatus.Added:&#xD;
		case SyncObjectStatus.Modified:&#xD;
		case SyncObjectStatus.Deleted:&#xD;
		default:&#xD;
		{&#xD;
