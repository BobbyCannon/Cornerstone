<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0</TargetFrameworks>
	</PropertyGroup>
	<ItemGroup>
		<!-- 
		Must use oldest System.Text.Json version here as this can't be higher than what VS ships with
		or intellisense will fail to load - see GH#298
		-->
		<PackageReference Include="System.Text.Json" Version="[4.6.0]" />
		<PackageReference Include="System.Memory" Version="[4.5.4]" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="dnlib" Version="3.6.0" />
	</ItemGroup>
	<Import Project="../Props/NullableEnable.props" />
	<Import Project="../Props/NetAnalyzers.props" />
	<ItemGroup>
		<!-- PublicKey is appended from Directory.Build.props; do not embed it here, or it is duplicated. -->
		<InternalsVisibleTo Include="Cornerstone.VisualStudio.Tests" />
	</ItemGroup>
</Project>