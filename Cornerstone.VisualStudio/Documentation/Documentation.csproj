<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<RootNamespace>Cornerstone.VisualStudio.Documentation</RootNamespace>
		<AssemblyName>Cornerstone.VisualStudio.Documentation</AssemblyName>
		<!-- Align with Cornerstone.Avalonia (repo props default to older Avalonia for the VS extension) -->
		<AvaloniaVersion>12.1.1</AvaloniaVersion>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<!-- Documentation host is not the VSIX; skip strong-name if key wiring is awkward -->
		<SignAssembly>false</SignAssembly>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\Cornerstone\Cornerstone.Avalonia\Cornerstone.Avalonia.csproj" />
		<ProjectReference Include="..\..\Cornerstone\Cornerstone\Cornerstone.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="**\*.md" Exclude="bin\**;obj\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
