<UserControl x:Class="Cornerstone.VisualStudio.Views.OptionsView"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:local="clr-namespace:Cornerstone.VisualStudio.Views"
		xmlns:conv="clr-namespace:Cornerstone.VisualStudio.Converters"
		xmlns:a="clr-namespace:Cornerstone.VisualStudio"
		mc:Ignorable="d"
		d:DesignHeight="450" d:DesignWidth="800">
	<!-- TEMP: Code Cleanup options UI removed for release. Restore xmlns:cleanup + section below when re-enabling (CodeCleanupUiEnabled). -->
	<UserControl.Resources>
		<conv:EnumValuesConverter x:Key="EnumValues" />
	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="10">
			<TextBlock Text="General" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
			<Grid HorizontalAlignment="Left">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="10" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="10" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="10" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="10" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition MinWidth="160" Width="Auto" />
					<ColumnDefinition Width="20" />
					<ColumnDefinition Width="220" />
				</Grid.ColumnDefinitions>

				<TextBlock Text="Default Document View:" Grid.Column="0" Grid.Row="0" VerticalAlignment="Top" />
				<ComboBox Grid.Column="2" Grid.Row="0" VerticalAlignment="Center"
						ItemsSource="{Binding Source={x:Type local:AvaloniaDesignerView}, Converter={StaticResource EnumValues}}"
						SelectedItem="{Binding DesignerView, Mode=TwoWay}" />

				<TextBlock Text="Split Orientation:" Grid.Column="0" Grid.Row="2" VerticalAlignment="Top" />
				<StackPanel Grid.Column="2" Grid.Row="2">
					<ComboBox VerticalAlignment="Center"
							ItemsSource="{Binding Source={x:Type Orientation}, Converter={StaticResource EnumValues}}"
							SelectedItem="{Binding DesignerSplitOrientation, Mode=TwoWay}" />
					<CheckBox VerticalAlignment="Center" Margin="0, 6, 0, 0"
							IsChecked="{Binding DesignerSplitSwapped, Mode=TwoWay}">
						Swapped
					</CheckBox>
				</StackPanel>

				<TextBlock Text="Default Zoom Level:" Grid.Column="0" Grid.Row="4" VerticalAlignment="Top" />
				<ComboBox Grid.Column="2" Grid.Row="4" VerticalAlignment="Center"
						ItemsSource="{x:Static a:ZoomLevels.Levels}"
						SelectedItem="{Binding ZoomLevel, Mode=TwoWay}" />

				<TextBlock Text="Minimum Log Verbosity:" Grid.Column="0" Grid.Row="6" VerticalAlignment="Top" />
				<ComboBox Grid.Column="2" Grid.Row="6" VerticalAlignment="Center"
						ItemsSource="{x:Static a:LogEventLevels.All}"
						SelectedItem="{Binding MinimumLogVerbosity, Mode=TwoWay}" />

				<CheckBox Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="3"
						VerticalAlignment="Center"
						IsChecked="{Binding ShowPreviewHostRunningInTab, Mode=TwoWay}"
						Content="Show • prefix on tab while previewer is running"
						ToolTip="When enabled, open AXAML tabs are prefixed with • while the design host process is alive (e.g. •MainView.axaml). Off by default." />
			</Grid>

			<!--
			TEMP: Code Cleanup options (hidden for release).
			When re-enabling: set CornerstoneConstants.CodeCleanupUiEnabled = true, restore vsct/menus,
			add xmlns:cleanup="clr-namespace:Cornerstone.VisualStudio.Core.Cleanup;assembly=Cornerstone.VisualStudio.Core",
			and uncomment this section.

			<Separator Margin="0,16,0,12" />

			<TextBlock Text="Cornerstone: Code Cleanup" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
			<TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="Gray"
					Text="Used by Tools → Cornerstone: Code Cleanup Document and Solution Explorer → Cornerstone: Code Cleanup. Assign a keyboard shortcut under Environment → Keyboard (search Cornerstone)." />

			<Grid HorizontalAlignment="Left">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="8" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="8" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="8" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="4" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="4" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="4" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="4" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="4" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition MinWidth="160" Width="Auto" />
					<ColumnDefinition Width="20" />
					<ColumnDefinition Width="280" />
				</Grid.ColumnDefinitions>

				<TextBlock Text="File extensions:" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" />
				<TextBox Grid.Column="2" Grid.Row="0" VerticalAlignment="Center"
						Text="{Binding CleanupFileExtensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
						ToolTip="Semicolon-separated list, e.g. .axaml;.xaml" />

				<TextBlock Text="Line endings:" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" />
				<ComboBox Grid.Column="2" Grid.Row="2" VerticalAlignment="Center"
						ItemsSource="{Binding Source={x:Type cleanup:CleanupLineEndingMode}, Converter={StaticResource EnumValues}}"
						SelectedItem="{Binding CleanupNormalizeLineEndings, Mode=TwoWay}" />

				<TextBlock Text="Indent size (spaces):" Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" />
				<TextBox Grid.Column="2" Grid.Row="4" VerticalAlignment="Center" Width="60" HorizontalAlignment="Left"
						Text="{Binding CleanupIndentSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

				<CheckBox Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="3"
						IsChecked="{Binding CleanupTrimTrailingWhitespace, Mode=TwoWay}"
						Content="Trim trailing whitespace" />
				<CheckBox Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="3"
						IsChecked="{Binding CleanupEnsureFinalNewline, Mode=TwoWay}"
						Content="Ensure final newline" />
				<CheckBox Grid.Column="0" Grid.Row="10" Grid.ColumnSpan="3"
						IsChecked="{Binding CleanupFormatXml, Mode=TwoWay}"
						Content="Format XML / XAML (when well-formed)" />
				<CheckBox Grid.Column="0" Grid.Row="12" Grid.ColumnSpan="3"
						IsChecked="{Binding CleanupSortXmlns, Mode=TwoWay}"
						Content="Sort xmlns attributes" />
				<CheckBox Grid.Column="0" Grid.Row="14" Grid.ColumnSpan="3"
						IsChecked="{Binding CleanupSortAttributes, Mode=TwoWay}"
						Content="Sort other attributes" />
				<CheckBox Grid.Column="0" Grid.Row="16" Grid.ColumnSpan="3"
						IsChecked="{Binding CleanupPreferSelfClosing, Mode=TwoWay}"
						Content="Prefer self-closing empty elements" />
			</Grid>
			-->

			<TextBlock Text="Thank you for using the Cornerstone extension. I hope you are enjoying it."
					TextWrapping="Wrap" FontSize="13" Margin="0,16,0,0" />
		</StackPanel>
	</ScrollViewer>
</UserControl>