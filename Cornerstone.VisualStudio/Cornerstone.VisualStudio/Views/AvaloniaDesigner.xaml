<UserControl x:Class="Cornerstone.VisualStudio.Views.AvaloniaDesigner"
		x:ClassModifier="internal"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:local="clr-namespace:Cornerstone.VisualStudio.Views"
		xmlns:conv="clr-namespace:Cornerstone.VisualStudio.Converters"
		mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800"
		Name="Root"
		Background="{DynamicResource VsBrush.ToolWindowBackground}"
		Foreground="{DynamicResource VsBrush.WindowText}">
	<!-- Toolbar glyphs are CrispImage + KnownMonikers, created in code-behind.
	     MarkupCompilePass1 cannot resolve Microsoft.VisualStudio.Imaging types from SDK package refs. -->

	<UserControl.Resources>
		<conv:EnumToIntConverter x:Key="EnumToInt" />
		<conv:NotNullOrEmptyToVisibilityConverter x:Key="NotNullOrEmpty" />
	</UserControl.Resources>

	<DockPanel>
		<TextBlock Name="PausedMessage"
				DockPanel.Dock="Top"
				Background="{DynamicResource VsBrush.InfoBackground}"
				Foreground="{DynamicResource VsBrush.InfoText}"
				Padding="4"
				VerticalAlignment="Top">
			The designer is paused waiting for a build to complete.
		</TextBlock>
		<DockPanel Name="Toolbar"
				DockPanel.Dock="Top"
				Margin="4"
				VerticalAlignment="Top">

			<DockPanel.Resources>
				<Style TargetType="ListBox">
					<Setter Property="Background" Value="Transparent" />
					<Setter Property="BorderThickness" Value="0" />
					<Setter Property="ItemsPanel">
						<Setter.Value>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</Setter.Value>
					</Setter>
					<Setter Property="Margin" Value="0 0 10 0" />
					<Setter Property="DockPanel.Dock" Value="Right" />
				</Style>
			</DockPanel.Resources>

			<ComboBox DockPanel.Dock="Right"
					ItemsSource="{Binding Targets, ElementName=Root}"
					SelectedItem="{Binding SelectedTarget, ElementName=Root}"
					DisplayMemberPath="Name"
					Padding="2"
					Visibility="{Binding Targets, ElementName=Root, Converter={StaticResource NotNullOrEmpty}}"
					local:VsTheme.UseVsTheme="True" />

			<ComboBox DockPanel.Dock="Right"
					Text="{Binding ZoomLevel, ElementName=Root, Mode=TwoWay}" IsEditable="True"
					ItemsSource="{x:Static local:AvaloniaDesigner.ZoomLevels}"
					Padding="2" Margin="0 0 10 0" local:VsTheme.UseVsTheme="True" />

			<Grid DockPanel.Dock="Left"
					Margin="0,0,20,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock x:Name="HeaderTitle"
						Grid.Column="0"
						Text="Cornerstone"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Margin="0,0,20,0" />
				<Button Grid.Column="1"
						VerticalAlignment="Center"
						DockPanel.Dock="Right"
						local:VsTheme.UseVsTheme="True"
						MinWidth="0" MinHeight="0"
						Padding="2" Margin="0 0 10 0"
						ToolTip="Start the process"
						Visibility="Collapsed">
					Start
				</Button>
			</Grid>
			<Grid DockPanel.Dock="Left"
					Name="ErrorIndicator">
				<Grid.ToolTip>
					<StackPanel Name="Error"
							HorizontalAlignment="Left"
							VerticalAlignment="Center">
						<TextBlock Name="ErrorHeading" FontSize="18" HorizontalAlignment="Center" />
						<TextBlock Name="ErrorMessage" Margin="0,20,0,0" />
					</StackPanel>
				</Grid.ToolTip>

				<Ellipse Height="18" Width="18" Fill="#f55762" />
				<TextBlock Text="!" HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="White"
						FontWeight="ExtraBold" />
			</Grid>

			<ListBox SelectedIndex="{Binding View, ElementName=Root, Mode=TwoWay, Converter={StaticResource EnumToInt}}">
				<ListBoxItem x:Name="ViewSplitItem" ToolTip="Split View" />
				<ListBoxItem x:Name="ViewDesignItem" ToolTip="Design View" />
				<ListBoxItem x:Name="ViewSourceItem" ToolTip="XAML View" />
			</ListBox>

			<ListBox SelectedIndex="{Binding SplitOrientation, ElementName=Root, Mode=TwoWay, Converter={StaticResource EnumToInt}}">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<ListBoxItem x:Name="OrientationHorizontalItem" ToolTip="Horizontal Layout" />
				<ListBoxItem x:Name="OrientationVerticalItem" ToolTip="Vertical Layout" />
			</ListBox>

			<Button VerticalAlignment="Center"
					DockPanel.Dock="Right"
					local:VsTheme.UseVsTheme="True"
					MinWidth="0" MinHeight="0"
					Padding="2" Margin="0 0 10 0"
					ToolTip="Swap Preview and Xaml panes"
					Click="SwapPreviewAndXamlPanes"
					x:Name="SwapPanesButton" />

			<Control />
		</DockPanel>

		<Grid x:Name="MainGrid" UseLayoutRounding="True">
			<Grid.RowDefinitions>
				<RowDefinition x:Name="PreviewRow" />
				<RowDefinition Height="Auto" />
				<RowDefinition x:Name="CodeRow" />
			</Grid.RowDefinitions>

			<!-- Not hit-testable: only decorative, must not steal splitter/editor input. -->
			<local:GridLines Grid.ColumnSpan="3"
					Grid.RowSpan="3"
					Margin="0,0,0,5"
					IsHitTestVisible="False" />

			<local:AvaloniaPreviewer x:Name="Previewer"
					Grid.Column="2"
					MinWidth="0"
					MinHeight="0" />

			<!--
				ResizeBehavior=PreviousAndNext with explicit ResizeDirection is set in code.
				Important: split panes use Absolute + Star (not Star/Star). WPF GridSplitter
				cancels Star/Star drags when the combined actual length changes mid-drag
				(common once the preview/scrollbars load).
			-->
			<GridSplitter x:Name="Splitter"
					Grid.Row="1"
					Grid.Column="1"
					VerticalAlignment="Stretch"
					HorizontalAlignment="Stretch"
					Height="5"
					ResizeBehavior="PreviousAndNext"
					Background="{DynamicResource VsBrush.PanelSeparator}" />

			<Decorator Grid.Row="2" Grid.Column="0" Name="EditorHost" MinWidth="0" MinHeight="0" />
		</Grid>
	</DockPanel>
</UserControl>