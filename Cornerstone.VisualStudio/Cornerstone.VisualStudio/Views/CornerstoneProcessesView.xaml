<UserControl
		x:Class="Cornerstone.VisualStudio.Views.CornerstoneProcessesView"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:views="clr-namespace:Cornerstone.VisualStudio.Views"
		views:VsControlStyles.UseVsControlStyles="True"
		Background="{DynamicResource VsBrush.ToolWindowBackground}"
		Foreground="{DynamicResource VsBrush.ToolWindowText}">
	<UserControl.Resources>
		<Style x:Key="ProcessFieldText" TargetType="TextBlock">
			<Setter Property="Margin" Value="0,0,12,0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
					<Setter Property="Visibility" Value="Collapsed" />
				</DataTrigger>
				<DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
					<Setter Property="Visibility" Value="Collapsed" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>
	<Border Background="{DynamicResource VsBrush.ToolWindowBackground}"
			BorderBrush="{DynamicResource VsBrush.GridLine}"
			BorderThickness="0,1,0,0">
		<ScrollViewer VerticalScrollBarVisibility="Auto"
				HorizontalScrollBarVisibility="Disabled">
			<ItemsControl x:Name="ProcessList">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border x:Name="Row"
								Padding="8,4"
								Background="Transparent"
								BorderBrush="{DynamicResource VsBrush.GridLine}"
								BorderThickness="0,0,0,1">
							<DockPanel LastChildFill="True">
								<Button DockPanel.Dock="Right"
										HorizontalAlignment="Right"
										VerticalAlignment="Center"
										Margin="8,0,0,0"
										Click="KillProcess"
										IsEnabled="{Binding CanKill}"
										Content="Close" />
								<WrapPanel VerticalAlignment="Center">
									<TextBlock Style="{StaticResource ProcessFieldText}" Text="{Binding Kind}" />
									<TextBlock Style="{StaticResource ProcessFieldText}" Text="{Binding Document}" />
									<TextBlock Style="{StaticResource ProcessFieldText}" Text="{Binding State}" />
									<TextBlock Style="{StaticResource ProcessFieldText}" Text="{Binding ProcessId}" />
									<TextBlock Style="{StaticResource ProcessFieldText}" Text="{Binding Detail}" />
									<TextBlock Style="{StaticResource ProcessFieldText}" Text="{Binding Platform}" />
									<TextBlock Text="{Binding Activity}" TextWrapping="Wrap">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Style.Triggers>
													<DataTrigger Binding="{Binding Activity}" Value="">
														<Setter Property="Visibility" Value="Collapsed" />
													</DataTrigger>
													<DataTrigger Binding="{Binding Activity}" Value="{x:Null}">
														<Setter Property="Visibility" Value="Collapsed" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</WrapPanel>
							</DockPanel>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Border>
</UserControl>