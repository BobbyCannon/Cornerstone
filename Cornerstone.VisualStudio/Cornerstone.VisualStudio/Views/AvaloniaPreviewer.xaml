<UserControl
		x:Class="Cornerstone.VisualStudio.Views.AvaloniaPreviewer"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		d:DesignHeight="450"
		d:DesignWidth="800"
		mc:Ignorable="d">
	<Grid x:Name="RootGrid" MinWidth="0" MinHeight="0" ClipToBounds="True">
		<!--
			Keep scrollbars Always visible so Auto show/hide does not change available
			layout space while the parent GridSplitter is dragging (that can cancel a
			Star/Star resize; we also use Absolute+Star in AvaloniaDesigner).
		-->
		<ScrollViewer
				x:Name="PreviewScroller"
				HorizontalScrollBarVisibility="Visible"
				VerticalScrollBarVisibility="Visible"
				MinWidth="0"
				MinHeight="0"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch">
			<Grid
					x:Name="PreviewGrid"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					UseLayoutRounding="True">
				<!-- Lightweight shadow: BlurEffect on a full-size border is expensive and
				     can expand visual bounds during layout thrash. -->
				<Border BorderBrush="#40000000" BorderThickness="1" Background="#10000000"
						Margin="3" />
				<Border BorderBrush="Black" BorderThickness="1">
					<Image
							Name="Preview"
							Width="100"
							Height="100"
							MouseDown="Preview_MouseDown"
							MouseMove="Preview_MouseMove"
							MouseUp="Preview_MouseUp" />
				</Border>
			</Grid>
		</ScrollViewer>

		<Border Name="Error"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				Background="#80808080"
				Visibility="Collapsed">

			<StackPanel Background="{DynamicResource VsBrush.ToolWindowBackground}"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
				<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
					<Grid Margin="0,0,7,0">
						<Ellipse
								Width="22"
								Height="22"
								Fill="#f55762" />
						<TextBlock
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontSize="16"
								FontWeight="ExtraBold"
								Foreground="{DynamicResource VsBrush.WindowText}"
								Text="!" />
					</Grid>

					<TextBlock
							Name="ErrorHeading"
							HorizontalAlignment="Center"
							FontSize="18" />
				</StackPanel>

				<TextBlock
						Name="ErrorMessage"
						Margin="20,10,20,0"
						HorizontalAlignment="Center"
						TextWrapping="Wrap" />
				<Button
						Name="BuildButton"
						Margin="0,15,0,0"
						Padding="7,5,7,5"
						Visibility="Hidden"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Content="Build" />
			</StackPanel>
		</Border>
	</Grid>
</UserControl>