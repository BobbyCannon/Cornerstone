<?xml version="1.0" encoding="utf-8"?>

<Project>
	<Import Sdk="Microsoft.NET.Sdk" Project="Sdk.props" />
	<PropertyGroup>
		<RootNamespace>Cornerstone.VisualStudio</RootNamespace>
		<AssemblyName>Cornerstone.VisualStudio</AssemblyName>
		<TargetFrameworks>net472</TargetFrameworks>
		<!-- Required for Page/XAML g.cs generation to participate in CoreCompile (SDK-style). -->
		<UseWPF>true</UseWPF>
		<!-- Hybrid: classic VSSDK package + VisualStudio.Extensibility settings contributions. -->
		<VssdkCompatibleExtension>true</VssdkCompatibleExtension>
		<GeneratePkgDefFile>true</GeneratePkgDefFile>
		<UseCodebase>true</UseCodebase>
		<IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
		<IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
		<IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
		<CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
		<CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
		<StartAction>Program</StartAction>
		<StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
		<StartArguments>/rootsuffix Exp</StartArguments>
		<!-- Required for VSPackage.resx icon (non-string resources) under modern .NET SDK -->
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
	</PropertyGroup>
	<ItemGroup Label="Snippet">
		<Content Include="Snippets\snippets.pkgdef">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Avalonia\Snippets\Avalonia_AP00.snippet">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Avalonia\Snippets\Avalonia_AP01.snippet">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Avalonia\Snippets\Avalonia_DP00.snippet">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Avalonia\Snippets\Avalonia_DP01.snippet">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Avalonia\Snippets\Avalonia_RE00.snippet">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Avalonia\Snippets\Avalonia_RE01.snippet">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Avalonia\Snippets\Avalonia_RE02.snippet">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Avalonia\Snippets\Avalonia_SP00.snippet">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Avalonia\Snippets\Avalonia_SP01.snippet">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<!-- Manifest Icon (PNG for Marketplace) + classic ICO for VSPackage.resx #400. -->
		<Content Include="Cornerstone.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="License.txt">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Cornerstone.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="icons.pkgdef">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Templates.pkgdef">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="overview.md">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<None Include="publishManifest.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="source.extension.vsixmanifest">
			<SubType>Designer</SubType>
		</None>
	</ItemGroup>
	<Target Name="PreCreateVsixContainer" BeforeTargets="GetVsixSourceItems">
		<PropertyGroup>
			<_CornerstoneTemplatesProject>$(MSBuildThisFileDirectory)..\..\Cornerstone.Templates\Cornerstone.Templates.csproj</_CornerstoneTemplatesProject>
			<_AvaloniaTemplateNupkg>$(NuGetPackageRoot)\$(AvaloniaTemplatesPackageName.ToLowerInvariant())\$(AvaloniaTemplatesPackageVersion)\$(AvaloniaTemplatesPackageName.ToLowerInvariant()).$(AvaloniaTemplatesPackageVersion).nupkg</_AvaloniaTemplateNupkg>
			<!-- Omit Version unless the extension build passed one. An empty Version would replace the templates project's own version. -->
			<_CornerstoneTemplatesPackProperties>Configuration=$(Configuration);TargetFramework=netstandard2.0</_CornerstoneTemplatesPackProperties>
			<_CornerstoneTemplatesPackProperties Condition="'$(CornerstonePackageVersion)' != ''">$(_CornerstoneTemplatesPackProperties);Version=$(CornerstonePackageVersion)</_CornerstoneTemplatesPackProperties>
		</PropertyGroup>
		<MSBuild Projects="$(_CornerstoneTemplatesProject)" Targets="Pack" Properties="$(_CornerstoneTemplatesPackProperties)" />
		<MSBuild Projects="$(_CornerstoneTemplatesProject)" Targets="GetTemplatePackageIdentity" Properties="$(_CornerstoneTemplatesPackProperties)">
			<Output TaskParameter="TargetOutputs" ItemName="_CornerstoneTemplatePackage" />
		</MSBuild>
		<PropertyGroup>
			<_CornerstoneTemplatesPackageVersion>%(_CornerstoneTemplatePackage.PackageVersion)</_CornerstoneTemplatesPackageVersion>
			<_CornerstoneTemplateNupkg>%(_CornerstoneTemplatePackage.NupkgPath)</_CornerstoneTemplateNupkg>
		</PropertyGroup>
		<ItemGroup>
			<_TemplatePackage Include="$(_AvaloniaTemplateNupkg)" />
			<_TemplatePackage Include="$(_CornerstoneTemplateNupkg)" />
			<_TemplatesPkgDefLine Include="[$RootKey$\TemplateEngine\Templates\avalonia.templates.nuspec\$(AvaloniaTemplatesPackageVersion)]" />
			<_TemplatesPkgDefLine Include="&quot;InstalledPath&quot;=&quot;$PackageFolder$\ProjectTemplates&quot;" />
			<_TemplatesPkgDefLine Include="[$RootKey$\TemplateEngine\Templates\cornerstone.templates.nuspec\$(_CornerstoneTemplatesPackageVersion)]" />
			<_TemplatesPkgDefLine Include="&quot;InstalledPath&quot;=&quot;$PackageFolder$\ProjectTemplates&quot;" />
		</ItemGroup>
		<Error Text="Avalonia.Templates nupkg not found at $(_AvaloniaTemplateNupkg)." Condition="!Exists('$(_AvaloniaTemplateNupkg)')" />
		<Error Text="Cornerstone.Templates package version was not returned from GetTemplatePackageIdentity." Condition="'$(_CornerstoneTemplatesPackageVersion)' == ''" />
		<Error Text="Cornerstone.Templates nupkg not found at $(_CornerstoneTemplateNupkg)." Condition="!Exists('$(_CornerstoneTemplateNupkg)')" />
		<WriteLinesToFile File="$(IntermediateOutputPath)Templates.pkgdef" Lines="@(_TemplatesPkgDefLine)" Overwrite="true" Encoding="UTF-8" />
		<Copy SourceFiles="$(IntermediateOutputPath)Templates.pkgdef" DestinationFiles="$(MSBuildProjectDirectory)\Templates.pkgdef" SkipUnchangedFiles="true" />
		<Message Text="Template nuget packages found: @(_TemplatePackage)" Importance="low" />
		<!-- don't modify the following, the pkgdef file uses the path below -->
		<ItemGroup>
			<VSIXSourceItem Include="@(_TemplatePackage)">
				<VSIXSubPath>ProjectTemplates\</VSIXSubPath>
			</VSIXSourceItem>
		</ItemGroup>
	</Target>
	<ItemGroup>
		<!-- Restore only: embed Avalonia.Templates nupkg in the VSIX (see PreCreateVsixContainer). -->
		<PackageDownload Include="$(AvaloniaTemplatesPackageName)" Version="[$(AvaloniaTemplatesPackageVersion)]" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia.Remote.Protocol" Version="$(AvaloniaVersion)" />
		<PackageReference Include="MessagePack" Version="2.5.302" />
		<PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.8.43" />
		<PackageReference Include="Microsoft.CodeAnalysis" Version="4.14.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
		<PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="4.14.0" />
		<PackageReference Include="Microsoft.VisualStudio.ProjectSystem" Version="17.9.380" />
		<PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime">
			<IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- Extensibility.Build replaces Microsoft.VSSDK.BuildTools for hybrid VSSDK + Extensibility packages. -->
		<PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Serilog" Version="4.0.0" />
		<PackageReference Include="Serilog.Sinks.Trace" Version="4.0.0" />
		<PackageReference Include="SerilogAnalyzer" Version="0.15.0" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="Microsoft.CSharp" />
		<Reference Include="PresentationCore" />
		<Reference Include="PresentationFramework" />
		<Reference Include="System" />
		<Reference Include="System.Data" />
		<Reference Include="System.Design" />
		<Reference Include="System.Drawing" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Xaml" />
		<Reference Include="System.Xml" />
		<Reference Include="WindowsBase" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Cornerstone.VisualStudio.Protocol\Cornerstone.VisualStudio.Protocol.csproj">
			<Name>Cornerstone.VisualStudio.Protocol</Name>
		</ProjectReference>
		<ProjectReference Include="..\Cornerstone.VisualStudio.Core\Cornerstone.VisualStudio.Core.csproj">
			<Project>{e5819b46-75d5-de32-dd91-c24396cd4162}</Project>
			<Name>Cornerstone.VisualStudio.Core</Name>
		</ProjectReference>
		<ProjectReference Include="..\..\Cornerstone.Presentation.Remote.Protocol\Cornerstone.Presentation.Remote.Protocol.csproj" AdditionalProperties="TargetFramework=netstandard2.0">
			<Name>Cornerstone.Presentation.Remote.Protocol</Name>
		</ProjectReference>
		<!-- https://github.com/dotnet/sdk/issues/433 -->
		<ProjectReference Update="@(ProjectReference)" AdditionalProperties="TargetFramework=netstandard2.0" />
		<!-- https://github.com/Microsoft/extendvs/issues/57 -->
		<ProjectReference Update="@(ProjectReference)" Name="%(Filename)" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\Cornerstone.Presentation.Remote.Wpf\Cornerstone.Presentation.Remote.Wpf.csproj" AdditionalProperties="TargetFramework=net472">
			<Name>Cornerstone.Presentation.Remote.Wpf</Name>
		</ProjectReference>
	</ItemGroup>
	<ItemGroup>
		<VSCTCompile Include="Commands\CornerstonePackage.vsct">
			<ResourceName>Menus.ctmenu</ResourceName>
		</VSCTCompile>
	</ItemGroup>
	<!--
	  ProvideMenuResource("Menus.ctmenu") needs a top-level managed stream named Menus.ctmenu.
	  Default VSSDK merge puts the CTO inside _EmptyResource.resources, which VS cannot load for this
	  package (UI library load fails → package init / designer broken). Embed the CTO directly instead.
	  Do not use MergeWithCTO with GenerateResourceUsePreserializedResources (VSSDK1012).
	-->
	<Target Name="EmbedMenusCtmenu" AfterTargets="VSCTCompile" BeforeTargets="CoreCompile;PrepareResources">
		<ItemGroup Condition="Exists('$(IntermediateOutputPath)CornerstonePackage.cto')">
			<EmbeddedResource Include="$(IntermediateOutputPath)CornerstonePackage.cto">
				<LogicalName>Menus.ctmenu</LogicalName>
				<Type>Non-Resx</Type>
				<WithCulture>false</WithCulture>
			</EmbeddedResource>
		</ItemGroup>
	</Target>
	<Target Name="StageEditorHost" BeforeTargets="GetVsixSourceItems">
		<MSBuild Projects="$(MSBuildThisFileDirectory)..\Cornerstone.VisualStudio.EditorHost\Cornerstone.VisualStudio.EditorHost.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net10.0" RemoveProperties="TargetFrameworks" />
		<ItemGroup>
			<_EditorHostFile Include="$(MSBuildThisFileDirectory)..\Cornerstone.VisualStudio.EditorHost\bin\$(Configuration)\net10.0\**\*.*" Exclude="**\*.pdb" />
			<VSIXSourceItem Include="@(_EditorHostFile)">
				<VSIXSubPath>EditorHost\%(RecursiveDir)</VSIXSubPath>
			</VSIXSourceItem>
		</ItemGroup>
	</Target>
	<Target Name="OrderVsixLicenseElement" AfterTargets="DetokenizeVsixManifestFile">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\Scripts\Repair-VsixManifestLicenseOrder.ps1&quot; -Path &quot;$(IntermediateVsixManifest)&quot;" />
	</Target>
	<!-- Extensibility.Build already imports Microsoft.VsSDK.targets; do not import it again. -->
	<Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />
</Project>