<Project>
	<PropertyGroup>
		<!-- Extension / assembly version; keep in sync via scripts/Update-ExtensionVersion.ps1 -->
		<Version>1.5.277.37869</Version>
		<AvaloniaTemplatesPackageName>Avalonia.Templates</AvaloniaTemplatesPackageName>
		<AvaloniaTemplatesPackageVersion>12.0.0</AvaloniaTemplatesPackageVersion>
		<AvaloniaVersion>12.0.0</AvaloniaVersion>
		<AvaloniaBaseVersion>12.0.0</AvaloniaBaseVersion>
		<LangVersion>12.0</LangVersion>
		<NoWarn>$(NoWarn);CEE0027;CS0162;CS1685;NU1608;VSSDK006;VSSDK007;VSTHRD010;VSTHRD100;VSTHRD110;</NoWarn>
		<SignAssembly>true</SignAssembly>
		<DelaySign>false</DelaySign>
		<AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\Cornerstone.snk</AssemblyOriginatorKeyFile>
		<!-- PublicKey matches Cornerstone.snk (same as Cornerstone Directory.Build.props). -->
		<PublicKey></PublicKey>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="IsExternalInit" Version="1.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>