<Window
		x:Class="Cornerstone.Presentation.Remote.Wpf.Host.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:remote="clr-namespace:Cornerstone.Presentation.Remote.Wpf;assembly=Cornerstone.Presentation.Remote.Wpf"
		Title="Cornerstone remote WPF"
		Width="960"
		Height="720">
	<DockPanel>
		<StatusBar DockPanel.Dock="Bottom">
			<StatusBarItem>
				<TextBlock x:Name="StatusText" Text="Starting…" />
			</StatusBarItem>
		</StatusBar>
		<remote:RemoteView x:Name="RemoteSurface" />
	</DockPanel>
</Window>