<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<StartupObject>Cornerstone.Designer.HostApp.Program</StartupObject>
		<RootNamespace>Cornerstone.Designer.HostApp</RootNamespace>
		<DefineConstants>$(DefineConstants);XAMLX_INTERNAL;XAML_RUNTIME_LOADER</DefineConstants>
		<IsPackable>false</IsPackable>
		<Nullable>disable</Nullable>
		<NoWarn>$(NoWarn);CS1591;CS8632</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="..\Cornerstone.Presentation.BuildTasks\XamlIlExtensions\**\*.cs" Link="XamlIlExtensions\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\Cornerstone.Generators\Presentation\XamlX\**\*.cs"
		         Exclude="..\Cornerstone.Generators\Presentation\XamlX\obj\**\*.cs;..\Cornerstone.Generators\Presentation\XamlX\Compatibility\**\*.cs"
		         Link="XamlX\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Cornerstone.Presentation\Cornerstone.Presentation.csproj" />
		<ProjectReference Include="..\Cornerstone.Presentation.Remote.Protocol\Cornerstone.Presentation.Remote.Protocol.csproj" />
	</ItemGroup>
</Project>
