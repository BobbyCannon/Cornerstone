<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net10.0-windows10.0.26100.0</TargetFrameworks>
		<SignAssembly>true</SignAssembly>
		<GenerateProgramFile>false</GenerateProgramFile>
		<DisableAutomaticXpfInit>true</DisableAutomaticXpfInit>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<OutputType>Library</OutputType>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>
	<ItemGroup>
		<TrimmerRootAssembly Include="Cornerstone" />
		<TrimmerRootAssembly Include="Cornerstone.Sample" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
		<PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\Applications\Cornerstone.RemoteLink\Cornerstone.RemoteLink.csproj" />
		<ProjectReference Include="..\..\Applications\Cornerstone.GrokMonitor\Cornerstone.GrokMonitor.csproj" />
		<ProjectReference Include="..\..\Cornerstone.Presentation.Remote.Protocol\Cornerstone.Presentation.Remote.Protocol.csproj" />
		<ProjectReference Include="..\..\Cornerstone.Sample\Cornerstone.Sample.csproj" />
		<ProjectReference Include="..\..\Cornerstone\Cornerstone.csproj" />
	</ItemGroup>
</Project>