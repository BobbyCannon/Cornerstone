<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net10.0-windows10.0.26100.0</TargetFrameworks>
		<SignAssembly>true</SignAssembly>
		<GenerateProgramFile>false</GenerateProgramFile>
		<DisableAutomaticXpfInit>true</DisableAutomaticXpfInit>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<OutputType>Library</OutputType>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>
	<ItemGroup>
		<TrimmerRootAssembly Include="Cornerstone" />
		<TrimmerRootAssembly Include="Cornerstone.Sample" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
		<PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\Cornerstone.GrokMonitor\Cornerstone.GrokMonitor.csproj" />
		<ProjectReference Include="..\..\Cornerstone.Sample\Cornerstone.Sample.csproj" />
		<ProjectReference Include="..\..\Cornerstone\Cornerstone.csproj" />
		<ProjectReference Include="..\..\Cornerstone.Generators\Cornerstone.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>
</Project>