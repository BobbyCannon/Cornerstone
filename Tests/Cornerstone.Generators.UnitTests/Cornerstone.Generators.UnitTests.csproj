<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net10.0-windows10.0.26100.0</TargetFrameworks>
		<SignAssembly>true</SignAssembly>
		<NoWarn>$(NoWarn);CS8002</NoWarn>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<GenerateProgramFile>false</GenerateProgramFile>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<OutputType>Library</OutputType>
		<IsTestProject>true</IsTestProject>
		<IsPackable>false</IsPackable>
		<PublishAot>false</PublishAot>
		<TrimMode>partial</TrimMode>
		<InvariantGlobalization>false</InvariantGlobalization>
	</PropertyGroup>
	<ItemGroup>
		<None Remove="coverage.xml" />
		<Compile Remove="**/*.received.cs" />
		<None Include="**/*.received.cs" />
		<Compile Remove="**/*.verified.cs" />
		<None Include="**/*.verified.cs" />
	</ItemGroup>
	<ItemGroup>
		<Compile Include="..\Cornerstone.UnitTests\CornerstoneUnitTest.cs" Link="CornerstoneUnitTest.cs" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
		<PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\Cornerstone.Presentation\Cornerstone.Presentation.csproj" />
		<ProjectReference Include="..\..\Cornerstone.Generators\Cornerstone.Generators.csproj" SetTargetFramework="TargetFramework=netstandard2.0" GlobalPropertiesToRemove="TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers" />
		<ProjectReference Include="..\..\Cornerstone\Cornerstone.csproj" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Presentation\NameGenerator\Views\*.xml" />
		<EmbeddedResource Include="Presentation\NameGenerator\OnlyProperties\GeneratedCode\*.txt" />
		<EmbeddedResource Include="Presentation\NameGenerator\InitializeComponent\GeneratedInitializeComponent\*.txt" />
		<EmbeddedResource Include="Presentation\PropertyGenerator\GeneratedCode\*.txt" />
	</ItemGroup>
</Project>