<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageType>Template</PackageType>
		<PackageId>Cornerstone.Templates</PackageId>
		<Title>Cornerstone Templates</Title>
		<Authors>Bobby Cannon</Authors>
		<Description>Project templates for Cornerstone: a basic desktop host, Keystone (Bus : State : Engine), and cross-platform hosts.</Description>
		<PackageTags>dotnet-new;templates;cornerstone;keystone</PackageTags>
		<TargetFramework>netstandard2.0</TargetFramework>
		<IncludeContentInPack>true</IncludeContentInPack>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<NoDefaultExcludes>true</NoDefaultExcludes>
		<PackageOutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\</PackageOutputPath>
		<!-- Packaging project: no assembly output or signing -->
		<SignAssembly>false</SignAssembly>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);NU5128;CS2008</NoWarn>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>License.txt</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="**\*" />
		<None Remove="**\*" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\License.txt" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- Directory.Build.props always adds the generators analyzer; not needed for this pack project. -->
	<ItemGroup>
		<ProjectReference Remove="@(ProjectReference)" />
	</ItemGroup>

	<Target Name="ConvertLiveTemplates" BeforeTargets="IncludeConvertedTemplateContent">
		<PropertyGroup>
			<_ConvertTemplatesScript>$(MSBuildThisFileDirectory)..\Templates\Convert-Templates.ps1</_ConvertTemplatesScript>
		</PropertyGroup>
		<Exec Command="pwsh -NoProfile -File &quot;$(_ConvertTemplatesScript)&quot; -Version &quot;$(Version)&quot;" />
	</Target>

	<!-- Content is snapshotted at evaluation, before ConvertLiveTemplates copies new files. -->
	<Target Name="IncludeConvertedTemplateContent" BeforeTargets="_GetPackageFiles">
		<ItemGroup>
			<Content Remove="content\**\*" />
			<Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**">
				<Pack>true</Pack>
				<PackagePath>content\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
			</Content>
		</ItemGroup>
	</Target>

	<Target Name="GetTemplatePackageIdentity" Returns="@(TemplatePackageIdentity)">
		<PropertyGroup>
			<_TemplatePackageVersion>$(PackageVersion)</_TemplatePackageVersion>
			<_TemplatePackageVersion Condition="'$(_TemplatePackageVersion)' == ''">$(Version)</_TemplatePackageVersion>
			<!-- NuGet omits a zero revision in the nupkg name and nuspec (3.0.0.0 becomes 3.0.0). -->
			<_TemplatePackageRevision>$([System.Version]::Parse('$(_TemplatePackageVersion)').Revision)</_TemplatePackageRevision>
			<_TemplatePackageVersion Condition="'$(_TemplatePackageRevision)' == '0'">$([System.Version]::Parse('$(_TemplatePackageVersion)').ToString(3))</_TemplatePackageVersion>
			<_TemplateNupkgPath>$([System.IO.Path]::GetFullPath('$(PackageOutputPath)$(PackageId).$(_TemplatePackageVersion).nupkg'))</_TemplateNupkgPath>
		</PropertyGroup>
		<ItemGroup>
			<TemplatePackageIdentity Include="$(PackageId)">
				<PackageVersion>$(_TemplatePackageVersion)</PackageVersion>
				<NupkgPath>$(_TemplateNupkgPath)</NupkgPath>
			</TemplatePackageIdentity>
		</ItemGroup>
	</Target>

</Project>
