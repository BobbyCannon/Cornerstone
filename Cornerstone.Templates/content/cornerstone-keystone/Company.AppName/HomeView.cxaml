<UserControl xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:Company.AppName"
		x:Class="Company.AppName.HomeView"
		x:DataType="local:HomeViewModel">
	<StackPanel Margin="24" Spacing="16"
			HorizontalAlignment="Center"
			VerticalAlignment="Center">
		<TextBlock Text="{Binding Greeting}"
				HorizontalAlignment="Center"
				TextWrapping="Wrap" />
		<Button Content="Greet"
				Command="{Binding GreetCommand}"
				HorizontalAlignment="Center" />
	</StackPanel>
</UserControl>
