{
  "$schema": "http://json.schemastore.org/template",
  "classifications": [ "Desktop", "Xaml", "Cornerstone", "Keystone", "Windows" ],
  "description": "A Cornerstone desktop app with AppBootstrap and Keystone (Bus : State : Engine).",
  "groupidentity": "Cornerstone.App",
  "identity": "Cornerstone.App",
  "name": "Cornerstone Desktop App",
  "preferNameDirectory": true,
  "shortName": "cornerstone.app",
  "sourceName": "Company.AppName",
  "defaultName": "CornerstoneApp",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the project on create.",
      "defaultValue": "false"
    },
    "CornerstoneVersion": {
      "type": "parameter",
      "description": "NuGet version of Cornerstone packages.",
      "datatype": "text",
      "replaces": "CornerstoneVersionTemplateParameter",
      "defaultValue": "3.0.277.17112"
    },
    "HostIdentifier": {
      "type": "bind",
      "binding": "HostIdentifier"
    }
  },
  "primaryOutputs": [
    { "path": "Company.AppName.csproj" },
    {
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "path": "AppWindow.cxaml.cs"
    },
    {
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "path": "AppWindow.cxaml"
    }
  ],
  "postActions": [
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        { "text": "Run 'dotnet restore'" }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    },
    {
      "id": "editor",
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "description": "Opens AppWindow in the editor",
      "manualInstructions": [],
      "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
      "args": {
        "files": "1;2"
      },
      "continueOnError": true
    }
  ]
}
