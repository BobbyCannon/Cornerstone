<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<CornerstoneUseCompiledBindingsByDefault>true</CornerstoneUseCompiledBindingsByDefault>
	</PropertyGroup>
	<ItemGroup>
		<CornerstoneXaml Include="**\*.cxaml" Exclude="bin\**;obj\**" />
		<CornerstoneResource Include="Assets\**" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Cornerstone" Version="CornerstoneVersionTemplateParameter" />
		<PackageReference Include="Cornerstone.Presentation" Version="CornerstoneVersionTemplateParameter" />
	</ItemGroup>
</Project>