<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="Cornerstone.Avalonia.DockingManager.DockingWindow"
		x:Name="This">
	<!-- Bind to the window property, not DataContext. Float windows set DataContext
	     to the host AppViewModel for shared context; DataContext.DockingManager would
	     be the root manager (or fail with x:DataType=DockingWindow). -->
	<ContentPresenter
			Content="{Binding ElementName=This, Path=DockingManager}"
			Margin="-1,0,-1,-1" />
</Window>