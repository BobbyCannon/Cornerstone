<Style xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Selector=":is(CornerstoneUserControl)">
	<Style.Resources>
		<ControlTheme x:Key="CornerstoneUserControl"
				TargetType="CornerstoneUserControl">
			<Setter Property="Template">
				<ControlTemplate>
					<Border Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}"
							Padding="{TemplateBinding Padding}">
						<ContentPresenter
								Name="PART_ContentPresenter"
								ContentTemplate="{TemplateBinding ContentTemplate}"
								Content="{TemplateBinding Content}"
								VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
								HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
					</Border>
				</ControlTemplate>
			</Setter>
		</ControlTheme>
	</Style.Resources>
	<Setter Property="Theme" Value="{StaticResource CornerstoneUserControl}" />
	<Design.PreviewWith>
		<CornerstoneUserControl Padding="20">
			<TextBlock FontSize="26"
					Text="This is a test" />
		</CornerstoneUserControl>
	</Design.PreviewWith>
	
</Style>