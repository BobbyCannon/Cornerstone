<ResourceDictionary xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:Cornerstone.Avalonia.Controls">

	<ControlTheme x:Key="{x:Type MarkdownView}" TargetType="local:MarkdownView">
		<Setter Property="Theme.Color" Value="Current" />
		<Setter Property="Background" Value="{DynamicResource Background03}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
		<Setter Property="FontFamily" Value="{x:Static CornerstoneTheme.DejaVuSansMono}" />
		<Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
		<Setter Property="Foreground" Value="{DynamicResource Foreground00}" />
		<Setter Property="Padding" Value="10" />
		<Setter Property="UseLayoutRounding" Value="True" />
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{TemplateBinding CornerRadius}">
					<ScrollViewer x:Name="PARTS_ScrollViewer"
							HorizontalScrollBarVisibility="Auto"
							VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{TemplateBinding BlockGroups}"
								Margin="{TemplateBinding Padding}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Spacing="10" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate DataType="local:MarkdownBlockGroup">
									<Panel>
										<!-- Structured table: links + inlines per cell -->
										<local:MarkdownTablePresenter DataContext="{Binding}"
												IsVisible="{Binding IsTable}" />
										<!-- Headers, code, paragraphs, lists, quotes -->
										<local:MarkdownBlockPresenter DataContext="{Binding}"
												IsVisible="{Binding !IsTable}" />
									</Panel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Border>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<Design.PreviewWith>
		<!-- Content is loaded via Document.Load / Append in samples; control has no string Markdown API. -->
		<PreviewCodeSnippet MaxWidth="680" MinHeight="400">
			<MarkdownView MinHeight="200" />
		</PreviewCodeSnippet>
	</Design.PreviewWith>
</ResourceDictionary>