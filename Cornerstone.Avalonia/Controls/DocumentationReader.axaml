<UserControl xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:Cornerstone.Avalonia.Controls"
		xmlns:tdg="clr-namespace:Cornerstone.Avalonia.TreeDataGrid;assembly=Cornerstone.Avalonia"
		x:Class="Cornerstone.Avalonia.Controls.DocumentationReader"
		Background="{DynamicResource Background02}">
	<DockPanel>
		<!-- Toolbar -->
		<Border DockPanel.Dock="Top"
				Background="{DynamicResource Background04}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="0,0,0,1"
				CornerRadius="0"
				Padding="10,8"
				ZIndex="10">
			<Grid ColumnDefinitions="Auto,*,Auto"
					MinHeight="36">
				<StackPanel Grid.Column="0"
						Orientation="Horizontal"
						Spacing="2"
						VerticalAlignment="Center">
					<Button x:Name="DocumentsPaneButton"
							Theme.Color="None"
							ToolTip.Tip="Documents"
							Click="DocumentsPaneButtonOnClick"
							Width="36"
							Height="36"
							Padding="0">
						<Path Width="16" Height="16"
								Stretch="Uniform"
								Fill="{DynamicResource Foreground00}"
								Data="{StaticResource Icons.Bars}"
								Margin="0,2,0,0"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Opacity="0.9" />
					</Button>
					<Button x:Name="BackButton"
							Theme.Color="None"
							ToolTip.Tip="Back"
							Click="BackButtonOnClick"
							Width="36"
							Height="36"
							Padding="0">
						<Path Width="14" Height="14"
								Stretch="Uniform"
								Fill="{DynamicResource Foreground00}"
								Data="{StaticResource Icons.Arrow.Left}"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Opacity="0.9" />
					</Button>
					<Button x:Name="HomeButton"
							Theme.Color="None"
							ToolTip.Tip="Home"
							Click="HomeButtonOnClick"
							Width="36"
							Height="36"
							Padding="0">
						<Path Width="18" Height="18"
								Stretch="Uniform"
								Fill="{DynamicResource Foreground00}"
								Data="{StaticResource Icons.Home}"
								Margin="0,2,0,0"
								HorizontalAlignment="Center"
								VerticalAlignment="Center" />
					</Button>
				</StackPanel>

				<StackPanel Grid.Column="1"
						Margin="12,0,12,0"
						VerticalAlignment="Center"
						Spacing="2">
					<TextBlock x:Name="TitleText"
							FontSize="15"
							FontWeight="SemiBold"
							TextTrimming="CharacterEllipsis"
							Foreground="{DynamicResource Foreground00}" />
					<TextBlock x:Name="PathText"
							FontSize="11"
							Opacity="0.55"
							TextTrimming="CharacterEllipsis"
							Foreground="{DynamicResource Foreground00}" />
				</StackPanel>

				<Border x:Name="StatusHost"
						Grid.Column="2"
						IsVisible="False"
						Background="{DynamicResource Background05}"
						CornerRadius="4"
						Padding="10,5"
						VerticalAlignment="Center"
						MaxWidth="280">
					<TextBlock x:Name="StatusText"
							FontSize="12"
							TextWrapping="Wrap"
							Opacity="0.9"
							Foreground="{DynamicResource Foreground00}" />
				</Border>
			</Grid>
		</Border>

		<!-- Body: optional docs pane + reading surface -->
		<SplitView x:Name="DocumentsSplit"
				DisplayMode="Overlay"
				OpenPaneLength="300"
				CompactPaneLength="0"
				IsPaneOpen="False"
				PaneBackground="{DynamicResource Background04}">
			<SplitView.Pane>
				<Border BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="0,0,1,0"
						Background="{DynamicResource Background04}">
					<DockPanel Margin="10,10,10,8">
						<TextBox x:Name="SearchBox"
								DockPanel.Dock="Top"
								PlaceholderText="Filter documents�"
								Margin="0,0,0,8"
								TextChanged="SearchBoxOnTextChanged" />
						<TextBlock x:Name="EmptyFilterText"
								DockPanel.Dock="Bottom"
								Text="No matching documents"
								Opacity="0.55"
								Margin="4,8,0,0"
								IsVisible="False" />
						<tdg:TreeDataGrid x:Name="DocTree"
								ShowColumnHeaders="False" />
					</DockPanel>
				</Border>
			</SplitView.Pane>

			<SplitView.Content>
				<Border Background="{DynamicResource Background02}">
					<Border MaxWidth="920"
							HorizontalAlignment="Stretch"
							Margin="16,12,16,16"
							Background="{DynamicResource Background03}"
							BorderBrush="{DynamicResource BorderBrush}"
							BorderThickness="1"
							CornerRadius="8"
							ClipToBounds="True">
						<controls:MarkdownView
								x:Name="MarkdownView"
								AutoScroll="False"
								WordWrap="True"
								BorderThickness="0"
								CornerRadius="8"
								Background="Transparent"
								FontFamily="{x:Static CornerstoneTheme.OpenSansRegular}"
								FontSize="15"
								Padding="28,24,28,32" />
					</Border>
				</Border>
			</SplitView.Content>
		</SplitView>
	</DockPanel>
</UserControl>