<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<ApplicationIcon>$(MSBuildThisFileDirectory)Cornerstone.ico</ApplicationIcon>
		<Company>Bobby Cannon</Company>
		<Authors>Bobby Cannon</Authors>
		<Copyright>© Copyright 2014</Copyright>
		<Version>3.0.277.37790</Version>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<FileVersion>$(Version)</FileVersion>
		<CornerstoneUseCompiledBindingsByDefault>true</CornerstoneUseCompiledBindingsByDefault>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<SignAssembly>true</SignAssembly>
		<DelaySign>false</DelaySign>
		<AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Cornerstone.snk</AssemblyOriginatorKeyFile>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<BuiltInComInteropSupport>false</BuiltInComInteropSupport>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- Nuget: opt in via Package.props (Templates sets its own flags). The generator DLL ships inside the Cornerstone package. -->
		<IsPackable>false</IsPackable>
		<Description>Shared .NET 10 framework for desktop and cross-platform apps: process bootstrap, Keystone (Bus, State, Engine), lifecycle, sync and storage, and an optional UI runtime. Markup is .cxaml, compiled at build time.</Description>
		<PackageIcon>Cornerstone.png</PackageIcon>
		<PackageIconUrl>https://raw.githubusercontent.com/BobbyCannon/Cornerstone/master/Cornerstone.png</PackageIconUrl>
		<PackageLicenseFile>license.txt</PackageLicenseFile>
		<PackageProjectUrl>https://github.com/BobbyCannon/Cornerstone</PackageProjectUrl>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/BobbyCannon/Cornerstone</RepositoryUrl>
	</PropertyGroup>
	<Import Project="$(MSBuildThisFileDirectory)Build\Warnings.props" />
	<PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
		<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
	</PropertyGroup>
	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)Cornerstone.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<PropertyGroup>
		<SkipCornerstoneGenerators>
			;Cornerstone.Generators;
			;Cornerstone.Generators.UnitTests;
			;Cornerstone.Generators.Vsix;
			;Cornerstone.Presentation.BuildTasks;
			;Cornerstone.Presentation.DevGenerators;
			;Cornerstone.Presentation.Remote.Protocol;
			;Cornerstone.Presentation.Remote.Wpf;
			;Cornerstone.Presentation.Remote.Wpf.Host;
			;Cornerstone.Designer.HostApp;
			;Cornerstone.Templates;
		</SkipCornerstoneGenerators>
	</PropertyGroup>
	<ItemGroup Condition="!$(SkipCornerstoneGenerators.Contains(';$(MSBuildProjectName);'))">
		<ProjectReference Include="$(MSBuildThisFileDirectory)Cornerstone.Generators\Cornerstone.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" SetTargetFramework="TargetFramework=netstandard2.0" GlobalPropertiesToRemove="TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers" />
	</ItemGroup>
</Project>