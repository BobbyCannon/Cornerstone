<Window xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:local="clr-namespace:Company.AppName"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="Company.AppName.AppWindow"
		x:DataType="local:AppViewModel"
		Icon="/Assets/Cornerstone.ico"
		Title="Company.AppName"
		Width="800" Height="450"
		WindowStartupLocation="CenterScreen">
	<TextBlock Text="{Binding Greeting}"
			HorizontalAlignment="Center"
			VerticalAlignment="Center" />
</Window>
