<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<CornerstoneUseCompiledBindingsByDefault>true</CornerstoneUseCompiledBindingsByDefault>
	</PropertyGroup>
	<ItemGroup>
		<CornerstoneXaml Include="**\*.cxaml" Exclude="bin\**;obj\**" />
		<CornerstoneResource Include="Assets\**" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\..\Cornerstone\Cornerstone.csproj" AdditionalProperties="TargetFramework=net10.0;TargetFrameworks=net10.0" GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifiers" />
	</ItemGroup>
	<Import Project="..\..\..\Build\Presentation.props" />
</Project>
