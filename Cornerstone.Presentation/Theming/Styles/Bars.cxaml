<Styles xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Style Selector="Border.ToolBar, Border.StatusBar">
		<Setter Property="Background" Value="{DynamicResource Background03}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="CornerRadius" Value="0" />
		<Setter Property="MinHeight" Value="34" />
		<Style Selector="^ Path, ^ PathIcon">
			<Setter Property="Height" Value="16" />
			<Setter Property="Width" Value="16" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="^ > Grid">
			<Setter Property="VerticalAlignment" Value="Stretch" />
			<Style Selector="^ > StackPanel">
				<Setter Property="Orientation" Value="Horizontal" />
				<Setter Property="VerticalAlignment" Value="Stretch" />
				<Setter Property="HorizontalAlignment" Value="Left" />
				<Style Selector="^ > :is(Control):not(Path):not(TextBlock):not(SelectableTextBlock)">
					<Setter Property="MinHeight" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ > TextBlock">
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ StackPanel > TextBlock">
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ WrapPanel > TextBlock">
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ > SelectableTextBlock">
					<Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
					<Setter Property="Margin" Value="0" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ StackPanel > SelectableTextBlock">
					<Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
					<Setter Property="Margin" Value="0" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ WrapPanel > SelectableTextBlock">
					<Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
					<Setter Property="Margin" Value="0" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ TextBlock.Label">
					<Setter Property="Foreground" Value="{DynamicResource Foreground03}" />
					<Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
					<Setter Property="Margin" Value="12,0,6,0" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ TextBlock.Value">
					<Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
					<Setter Property="Margin" Value="0" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ > Button">
					<Setter Property="MinHeight" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="MinWidth" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="VerticalAlignment" Value="Center" />
					<Style Selector="^.Icon Path">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
					<Style Selector="^.Icon PathIcon">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
				</Style>
				<Style Selector="^ > ToggleButton">
					<Setter Property="MinHeight" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="MinWidth" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="VerticalAlignment" Value="Center" />
					<Style Selector="^.Icon Path">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
					<Style Selector="^.Icon PathIcon">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
				</Style>
				<Style Selector="^ > SplitButton">
					<Setter Property="MinHeight" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="MinWidth" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="VerticalAlignment" Value="Center" />
					<Style Selector="^.Icon Path">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
					<Style Selector="^.Icon PathIcon">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
				</Style>
				<Style Selector="^ > DropDownButton">
					<Setter Property="MinHeight" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="MinWidth" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="VerticalAlignment" Value="Center" />
					<Style Selector="^.Icon Path">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
					<Style Selector="^.Icon PathIcon">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
				</Style>
				<Style Selector="^ > ComboBox">
					<Setter Property="Background" Value="Transparent" />
					<Setter Property="BorderThickness" Value="0" />
					<Setter Property="MinHeight" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="MinWidth" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="Padding" Value="4,0,0,0" />
				</Style>
				<Style Selector="^ > TextBox">
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ > ToggleSwitch">
					<Setter Property="Background" Value="Transparent" />
					<Setter Property="Margin" Value="0" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
			</Style>
			<Style Selector="^ > WrapPanel">
				<Setter Property="Orientation" Value="Horizontal" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="HorizontalAlignment" Value="Left" />
				<Style Selector="^ > Path">
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ > PathIcon">
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ > :is(Control):not(Path):not(TextBlock):not(SelectableTextBlock)">
					<Setter Property="MinHeight" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ > TextBlock">
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ StackPanel > TextBlock">
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ WrapPanel > TextBlock">
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ > SelectableTextBlock">
					<Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
					<Setter Property="Margin" Value="0" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ StackPanel > SelectableTextBlock">
					<Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
					<Setter Property="Margin" Value="0" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ WrapPanel > SelectableTextBlock">
					<Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
					<Setter Property="Margin" Value="0" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ TextBlock.Label">
					<Setter Property="Foreground" Value="{DynamicResource Foreground03}" />
					<Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
					<Setter Property="Margin" Value="12,0,6,0" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ TextBlock.Value">
					<Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
					<Setter Property="Margin" Value="0" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ > Button">
					<Setter Property="MinHeight" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="MinWidth" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="VerticalAlignment" Value="Center" />
					<Style Selector="^.Icon Path">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
					<Style Selector="^.Icon PathIcon">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
				</Style>
				<Style Selector="^ > ToggleButton">
					<Setter Property="MinHeight" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="MinWidth" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="VerticalAlignment" Value="Center" />
					<Style Selector="^.Icon Path">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
					<Style Selector="^.Icon PathIcon">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
				</Style>
				<Style Selector="^ > SplitButton">
					<Setter Property="MinHeight" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="MinWidth" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="VerticalAlignment" Value="Center" />
					<Style Selector="^.Icon Path">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
					<Style Selector="^.Icon PathIcon">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
				</Style>
				<Style Selector="^ > DropDownButton">
					<Setter Property="MinHeight" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="MinWidth" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="VerticalAlignment" Value="Center" />
					<Style Selector="^.Icon Path">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
					<Style Selector="^.Icon PathIcon">
						<Setter Property="Height" Value="16" />
						<Setter Property="Width" Value="16" />
					</Style>
				</Style>
				<Style Selector="^ > ComboBox">
					<Setter Property="Background" Value="Transparent" />
					<Setter Property="BorderThickness" Value="0" />
					<Setter Property="MinHeight" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="MinWidth" Value="{Binding $parent[Border].MinHeight}" />
					<Setter Property="Padding" Value="4,0,0,0" />
				</Style>
				<Style Selector="^ > TextBox">
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
				<Style Selector="^ > ToggleSwitch">
					<Setter Property="Background" Value="Transparent" />
					<Setter Property="Margin" Value="0" />
					<Setter Property="VerticalAlignment" Value="Center" />
				</Style>
			</Style>
			<Style Selector="^ > StackPanel:nth-child(1)">
				<Setter Property="Grid.Column" Value="0" />
			</Style>
			<Style Selector="^ > WrapPanel:nth-child(1)">
				<Setter Property="Grid.Column" Value="0" />
			</Style>
			<Style Selector="^ > StackPanel:nth-child(2)">
				<Setter Property="Grid.Column" Value="1" />
				<Setter Property="HorizontalAlignment" Value="Center" />
			</Style>
			<Style Selector="^ > WrapPanel:nth-child(2)">
				<Setter Property="Grid.Column" Value="1" />
				<Setter Property="HorizontalAlignment" Value="Center" />
			</Style>
			<Style Selector="^ > StackPanel:nth-child(3)">
				<Setter Property="Grid.Column" Value="2" />
				<Setter Property="HorizontalAlignment" Value="Right" />
			</Style>
			<Style Selector="^ > WrapPanel:nth-child(3)">
				<Setter Property="Grid.Column" Value="2" />
				<Setter Property="HorizontalAlignment" Value="Right" />
				<Setter Property="ItemsAlignment" Value="End" />
			</Style>
		</Style>
	</Style>

	<Style Selector="Border.StatusBar">
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="BorderThickness" Value="0,1,0,0" />
	</Style>

	<Style Selector="Border.ToolBar">
		<Setter Property="BorderThickness" Value="0,0,0,1" />
	</Style>

	<Design.PreviewWith>
		<PreviewCodeSnippet Width="760">
			<StackPanel>
				<Border Classes="ToolBar">
					<Grid>
						<StackPanel>
							<Button Classes="Icon">
								<Path Data="{StaticResource Icons.Asterisk}" />
							</Button>
							<Button Classes="Icon">
								<PathIcon Data="{DynamicResource Icons.Asterisk}" />
							</Button>
							<ToggleSwitch />
						</StackPanel>
						<StackPanel>
							<ToggleButton Classes="Icon" IsChecked="True">
								<Path Data="{StaticResource Icons.Asterisk}" />
							</ToggleButton>
							<SplitButton Classes="Icon">
								<Path Data="{StaticResource Icons.Asterisk}" />
							</SplitButton>
						</StackPanel>
						<StackPanel>
							<ComboBox SelectedIndex="0"
									ControlHelper.DisplayName="Option">
								<ComboBoxItem>Test 1</ComboBoxItem>
								<ComboBoxItem>Test 2</ComboBoxItem>
							</ComboBox>
						</StackPanel>
					</Grid>
				</Border>
				<Border Classes="ToolBar" MinHeight="42">
					<Grid>
						<WrapPanel>
							<Button Classes="Icon">
								<Path Data="{StaticResource Icons.Asterisk}" />
							</Button>
							<ToggleButton Classes="Icon" IsChecked="True">
								<PathIcon Data="{DynamicResource Icons.Asterisk}" />
							</ToggleButton>
						</WrapPanel>
						<WrapPanel>
							<TextBlock Classes="Label" Text="Font" />
							<TextBlock Classes="Value" Text="12" />
						</WrapPanel>
						<WrapPanel>
							<ToggleSwitch />
						</WrapPanel>
					</Grid>
				</Border>
				<Border Classes="StatusBar">
					<Grid>
						<StackPanel>
							<Path Data="{StaticResource Icons.Asterisk}"
									Margin="8,0,0,0" />
							<TextBlock Classes="Label" Text="Font" />
							<TextBlock Classes="Value" Text="12" />
						</StackPanel>
						<StackPanel>
							<Button Classes="Icon">
								<Path Data="{StaticResource Icons.Bell}" />
							</Button>
							<ToggleButton Classes="Icon" IsChecked="True">
								<Path Data="{StaticResource Icons.Bookmark}" />
							</ToggleButton>
						</StackPanel>
						<StackPanel>
							<Button Classes="Icon">
								<PathIcon Data="{StaticResource Icons.Bell}" />
							</Button>
							<ComboBox SelectedIndex="0"
									ControlHelper.DisplayName="Option">
								<ComboBoxItem>Test 1</ComboBoxItem>
								<ComboBoxItem>Test 2</ComboBoxItem>
							</ComboBox>
						</StackPanel>
					</Grid>
				</Border>
				<Border Classes="StatusBar">
					<Grid>
						<WrapPanel Margin="10,0,0,0">
							<Path Data="{StaticResource Icons.Asterisk}"
									Fill="{StaticResource Amber}" />
							<TextBlock Classes="Label" Text="Font" />
							<TextBlock Classes="Value" Text="16" />
							<TextBlock Classes="Label" Text="Lines" />
							<TextBlock Classes="Value" Text="1" />
						</WrapPanel>
						<WrapPanel />
						<WrapPanel>
							<ToggleButton Classes="Icon IconOnly Dim">
								<Path Data="{StaticResource Icons.Cog}" />
							</ToggleButton>
						</WrapPanel>
					</Grid>
				</Border>
			</StackPanel>
		</PreviewCodeSnippet>
	</Design.PreviewWith>
</Styles>
