<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\Cornerstone.Presentation.BuildTasks\CornerstoneBuildTasks.props" />
	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-browser;net10.0-windows10.0.26100.0</TargetFrameworks>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>Cornerstone.Presentation</RootNamespace>
		<AssemblyTitle>Cornerstone.Presentation</AssemblyTitle>
		<PackageId>Cornerstone.Presentation</PackageId>
		<!-- Forked UI runtime is annotated; Cornerstone keeps NRT disabled. -->
		<NoWarn>$(NoWarn);CS8632;CS0649;SYSLIB1051</NoWarn>
		<_CornerstonePublicKey></_CornerstonePublicKey>

		<_PresentationPlatform>$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_PresentationPlatform>
		<_PresentationIsAndroid Condition="'$(_PresentationPlatform)' == 'android'">true</_PresentationIsAndroid>
		<_PresentationIsIos Condition="'$(_PresentationPlatform)' == 'ios'">true</_PresentationIsIos>
		<_PresentationIsBrowser Condition="'$(_PresentationPlatform)' == 'browser'">true</_PresentationIsBrowser>
		<!-- net10.0 has no platform identifier (Win32 / macOS / X11 / Wayland). windows TFM is Win32 + WinRT/WebView2. -->
		<_PresentationIsDesktop Condition="'$(_PresentationPlatform)' == '' OR '$(_PresentationPlatform)' == 'windows'">true</_PresentationIsDesktop>
		<SupportedOSPlatformVersion Condition="'$(_PresentationIsAndroid)' == 'true'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="'$(_PresentationIsIos)' == 'true'">13.0</SupportedOSPlatformVersion>
		<AndroidResgenNamespace Condition="'$(_PresentationIsAndroid)' == 'true'">Cornerstone.Presentation.Android.Internal</AndroidResgenNamespace>
	</PropertyGroup>
	<PropertyGroup Condition="'$(_PresentationIsDesktop)' == 'true'">
		<EnableRuntimeMarshalling>true</EnableRuntimeMarshalling>
		<UseMicroComGeneratorRoslyn>true</UseMicroComGeneratorRoslyn>
		<!-- Local Mac Xcode output. Shipping dylib is runtimes/osx/native/libCornerstoneNative.dylib (in git). -->
		<NativeDylibPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)Platforms\MacOS\Build\Products\Release\libCornerstoneNative.dylib'))</NativeDylibPath>
	</PropertyGroup>
	<Import Project="..\Package.props" />
	<ItemGroup>
		<None Update="NOTICE.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludePresentationToolingInPackage</TargetsForTfmSpecificContentInPackage>
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeRemoteProtocolInPackage</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>

	<!-- SDK compiles every Platforms folder. Drop trees that are not this TFM. Headless and Remote stay on every TFM.
	     Re-include only *.cs. The SDK already lists other files as None, and a second None include warns at project load. -->
	<ItemGroup>
		<Compile Remove="Compatibility\**" />
		<None Include="Compatibility\**\*.cs" />
		<Compile Remove="Platforms\Android\**" Condition="'$(_PresentationIsAndroid)' != 'true'" />
		<None Include="Platforms\Android\**\*.cs" Condition="'$(_PresentationIsAndroid)' != 'true'" />
		<Compile Remove="Platforms\iOS\**" Condition="'$(_PresentationIsIos)' != 'true'" />
		<None Include="Platforms\iOS\**\*.cs" Condition="'$(_PresentationIsIos)' != 'true'" />
		<Compile Remove="Platforms\Browser\**" Condition="'$(_PresentationIsBrowser)' != 'true'" />
		<None Include="Platforms\Browser\**\*.cs" Condition="'$(_PresentationIsBrowser)' != 'true'" />
		<Compile Remove="Platforms\Windows\**" Condition="'$(_PresentationIsDesktop)' != 'true'" />
		<None Include="Platforms\Windows\**\*.cs" Condition="'$(_PresentationIsDesktop)' != 'true'" />
		<Compile Remove="Platforms\Windows\CameraAdapter.cs" Condition="'$(_PresentationPlatform)' != 'windows'" />
		<Compile Remove="Platforms\Windows\WebView2Adapter.cs" Condition="'$(_PresentationPlatform)' != 'windows'" />
		<Compile Remove="Platforms\Windows\HostAppBuilderExtensions.cs" Condition="'$(_PresentationPlatform)' != 'windows'" />
		<Compile Remove="Platforms\MacOS\**" Condition="'$(_PresentationIsDesktop)' != 'true'" />
		<None Include="Platforms\MacOS\**\*.cs" Condition="'$(_PresentationIsDesktop)' != 'true'" />
		<Compile Remove="Platforms\FreeDesktop\**" Condition="'$(_PresentationIsDesktop)' != 'true'" />
		<None Include="Platforms\FreeDesktop\**\*.cs" Condition="'$(_PresentationIsDesktop)' != 'true'" />
		<Compile Remove="Platforms\X11\**" Condition="'$(_PresentationIsDesktop)' != 'true'" />
		<None Include="Platforms\X11\**\*.cs" Condition="'$(_PresentationIsDesktop)' != 'true'" />
		<Compile Remove="Platforms\Wayland\**" Condition="'$(_PresentationIsDesktop)' != 'true'" />
		<None Include="Platforms\Wayland\**\*.cs" Condition="'$(_PresentationIsDesktop)' != 'true'" />
		<Compile Remove="Platforms\AppBuilderDesktopExtensions.cs" Condition="'$(_PresentationIsDesktop)' != 'true'" />
		<None Include="Platforms\AppBuilderDesktopExtensions.cs" Condition="'$(_PresentationIsDesktop)' != 'true'" />
		<Compile Remove="Platforms\OperatingSystemTheme.Desktop.cs" Condition="'$(_PresentationIsDesktop)' != 'true'" />
		<None Include="Platforms\OperatingSystemTheme.Desktop.cs" Condition="'$(_PresentationIsDesktop)' != 'true'" />
		<Compile Remove="Platforms\OperatingSystemTheme.Fallback.cs" Condition="'$(_PresentationIsDesktop)' == 'true'" />
		<None Include="Platforms\OperatingSystemTheme.Fallback.cs" Condition="'$(_PresentationIsDesktop)' == 'true'" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Cornerstone.Presentation.Remote.Protocol\Input\Key.cs" Link="Input\Key.cs" />
		<Compile Include="..\Cornerstone.Presentation.Remote.Protocol\Input\PhysicalKey.cs" Link="Input\PhysicalKey.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Cornerstone\Cornerstone.csproj" />
		<!-- Compiled against the protocol project. The DLL is packed into this nupkg; it is not a package dependency. -->
		<ProjectReference Include="..\Cornerstone.Presentation.Remote.Protocol\Cornerstone.Presentation.Remote.Protocol.csproj" PrivateAssets="all" />
		<ProjectReference Include="..\Cornerstone.Presentation.BuildTasks\Cornerstone.Presentation.BuildTasks.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" SetTargetFramework="TargetFramework=netstandard2.0" GlobalPropertiesToRemove="TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers" />
		<ProjectReference Include="..\Cornerstone.Presentation.DevGenerators\Cornerstone.Presentation.DevGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" SetTargetFramework="TargetFramework=netstandard2.0" GlobalPropertiesToRemove="TargetFrameworks;RuntimeIdentifier;RuntimeIdentifiers" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="composition-schema.xml" GenerateDBusTypes="false" />
		<EmbeddedResource Include="Backends\Skia\Assets\NoiseAsset_256X256_PNG.png" />
		<EmbeddedResource Include="Controls\Text\Resources\RightArrow.cur" />
		<EmbeddedResource Include="Platforms\Headless\BareMinimum.ttf" LogicalName="Cornerstone.Presentation.Headless.BareMinimum.ttf" />
		<CornerstoneResource Include="Dialogs\Assets\Roboto-Light.ttf" />
		<CornerstoneResource Include="Assets\**" />
		<CornerstoneXaml Include="**\*.cxaml" Exclude="bin\**;obj\**" />
		<CornerstoneXaml Include="Controls\ColorPickers\Themes\Simple\*.xaml" />
		<CornerstoneXaml Include="Dialogs\AboutCornerstoneDialog.xaml" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Cornerstone.Presentation.Diagnostics, PublicKey=$(_CornerstonePublicKey)" />
		<InternalsVisibleTo Include="Cornerstone.Designer.HostApp, PublicKey=$(_CornerstonePublicKey)" />
		<InternalsVisibleTo Include="Cornerstone.UnitTests, PublicKey=$(_CornerstonePublicKey)" />
		<InternalsVisibleTo Include="Cornerstone.Presentation.UnitTests, PublicKey=$(_CornerstonePublicKey)" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2, " />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MessagePack" Version="2.5.302" />
		<PackageReference Include="MicroCom.Runtime" Version="0.11.6" />
		<PackageReference Include="SkiaSharp" Version="3.119.4" />
		<PackageReference Include="HarfBuzzSharp" Version="14.2.1.102" />
	</ItemGroup>

	<ItemGroup Condition="'$(_PresentationPlatform)' == 'windows'">
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
	</ItemGroup>
	<PropertyGroup Condition="'$(_PresentationPlatform)' == 'windows'">
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>
	<ItemGroup Condition="'$(_PresentationIsAndroid)' == 'true'">
		<PackageReference Include="Xamarin.AndroidX.Camera.Core" Version="1.6.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Camera.View" Version="1.6.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.1.1" />
	</ItemGroup>
	<ItemGroup Condition="'$(_PresentationIsDesktop)' == 'true'">
		<PackageReference Include="MicroCom.CodeGenerator.Roslyn" Version="0.11.6">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.257">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.102" />
		<PackageReference Include="NWayland" Version="0.11.0" />
		<PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
		<PackageReference Include="Tmds.DBus.Generator" Version="0.94.1">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup Condition="'$(_PresentationIsDesktop)' == 'true'">
		<AdditionalFiles Include="Platforms\Windows\NativeMethods.txt" GenerateDBusTypes="false" />
		<MicroComIdl Include="Platforms\Windows\**\*.idl" />
		<MicroComIdl Include="Platforms\MacOS\csn.idl" />
		<!-- SDK glob already includes these as None; AdditionalFiles would duplicate that action in VS. -->
		<None Remove="Platforms\FreeDesktop\DBusXml\*.xml" />
		<AdditionalFiles Include="Platforms\FreeDesktop\DBusXml\com.canonical.AppMenu.Registrar.xml" Namespace="Cornerstone.Presentation.FreeDesktop.DBus" DBusGeneratorMode="Proxy" />
		<AdditionalFiles Include="Platforms\FreeDesktop\DBusXml\com.canonical.dbusmenu.xml" Namespace="Cornerstone.Presentation.FreeDesktop.DBus" DBusGeneratorMode="Handler" />
		<AdditionalFiles Include="Platforms\FreeDesktop\DBusXml\org.fcitx.Fcitx.InputContext.xml" Namespace="Cornerstone.Presentation.FreeDesktop.DBusIme.Fcitx.DBus" DBusGeneratorMode="Proxy" />
		<AdditionalFiles Include="Platforms\FreeDesktop\DBusXml\org.fcitx.Fcitx.InputMethod.xml" Namespace="Cornerstone.Presentation.FreeDesktop.DBusIme.Fcitx.DBus" DBusGeneratorMode="Proxy" />
		<AdditionalFiles Include="Platforms\FreeDesktop\DBusXml\org.fcitx.Fcitx.InputContext1.xml" Namespace="Cornerstone.Presentation.FreeDesktop.DBusIme.Fcitx.DBus" DBusGeneratorMode="Proxy" />
		<AdditionalFiles Include="Platforms\FreeDesktop\DBusXml\org.fcitx.Fcitx.InputMethod1.xml" Namespace="Cornerstone.Presentation.FreeDesktop.DBusIme.Fcitx.DBus" DBusGeneratorMode="Proxy" />
		<AdditionalFiles Include="Platforms\FreeDesktop\DBusXml\org.freedesktop.DBus.xml" Namespace="Cornerstone.Presentation.FreeDesktop.DBus" DBusGeneratorMode="Proxy" />
		<AdditionalFiles Include="Platforms\FreeDesktop\DBusXml\org.freedesktop.IBus.Portal.xml" Namespace="Cornerstone.Presentation.FreeDesktop.DBusIme.IBus.DBus" DBusGeneratorMode="Proxy" />
		<AdditionalFiles Include="Platforms\FreeDesktop\DBusXml\org.freedesktop.portal.FileChooser.xml" Namespace="Cornerstone.Presentation.FreeDesktop.DBus" DBusGeneratorMode="Proxy" />
		<AdditionalFiles Include="Platforms\FreeDesktop\DBusXml\org.freedesktop.portal.Request.xml" Namespace="Cornerstone.Presentation.FreeDesktop.DBus" DBusGeneratorMode="Proxy" />
		<AdditionalFiles Include="Platforms\FreeDesktop\DBusXml\org.freedesktop.portal.Settings.xml" Namespace="Cornerstone.Presentation.FreeDesktop.DBus" DBusGeneratorMode="Proxy" />
		<AdditionalFiles Include="Platforms\FreeDesktop\DBusXml\org.kde.StatusNotifierWatcher.xml" Namespace="Cornerstone.Presentation.FreeDesktop.DBus" DBusGeneratorMode="Proxy" />
		<AdditionalFiles Include="Platforms\FreeDesktop\DBusXml\org.kde.StatusNotifierItem.xml" Namespace="Cornerstone.Presentation.FreeDesktop.DBus" DBusGeneratorMode="Handler" />
		<!-- ObjC/C++ plus a nested GenerateCppHeaders project; must not compile into this assembly. -->
		<Compile Remove="Platforms\MacOS\Cornerstone.Native\**" />
		<None Include="Platforms\MacOS\Cornerstone.Native\**\*.cs" />
	</ItemGroup>

	<ItemGroup Condition="'$(_PresentationIsDesktop)' == 'true'">
		<Content Include="$(NativeDylibPath)" Condition="Exists('$(NativeDylibPath)')">
			<Link>libCornerstoneNative.dylib</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<ContentWithTargetPath Include="runtimes\osx\native\libCornerstoneNative.dylib" Condition="Exists('runtimes\osx\native\libCornerstoneNative.dylib')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<TargetPath>runtimes\osx\native\libCornerstoneNative.dylib</TargetPath>
		</ContentWithTargetPath>
		<ContentWithTargetPath Include="runtimes\win-x64\native\av_libglesv2.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<TargetPath>runtimes\win-x64\native\av_libglesv2.dll</TargetPath>
		</ContentWithTargetPath>
		<ContentWithTargetPath Include="runtimes\win-x86\native\av_libglesv2.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<TargetPath>runtimes\win-x86\native\av_libglesv2.dll</TargetPath>
		</ContentWithTargetPath>
		<ContentWithTargetPath Include="runtimes\win-arm64\native\av_libglesv2.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<TargetPath>runtimes\win-arm64\native\av_libglesv2.dll</TargetPath>
		</ContentWithTargetPath>
	</ItemGroup>

	<ItemGroup Condition="'$(_PresentationIsAndroid)' == 'true'">
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.1.4" />
		<PackageReference Include="Xamarin.AndroidX.Window" Version="1.5.1.2" />
		<PackageReference Include="Xamarin.AndroidX.DocumentFile" Version="1.1.0.3" />
	</ItemGroup>

	<ItemGroup Condition="'$(_PresentationIsBrowser)' == 'true'">
		<SupportedPlatform Remove="@(SupportedPlatform)" />
		<SupportedPlatform Include="browser" />
		<PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.4" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.2.1.102" />
	</ItemGroup>

	<Import Project="..\Cornerstone.Presentation.BuildTasks\CornerstoneBuildTasks.targets" />
	<Target Name="IncludeRemoteProtocolInPackage">
		<ItemGroup>
			<BuildOutputInPackage Include="$(OutputPath)Cornerstone.Presentation.Remote.Protocol.dll" />
		</ItemGroup>
	</Target>
	<Target Name="IncludePresentationToolingInPackage" Condition="'$(TargetFramework)' == 'net10.0'">
		<PropertyGroup>
			<_PresentationBuildTasksDir>$(MSBuildThisFileDirectory)..\Cornerstone.Presentation.BuildTasks\tools\$(Configuration)\netstandard2.0\</_PresentationBuildTasksDir>
			<_PresentationNugetDir>$(MSBuildThisFileDirectory)Nuget\</_PresentationNugetDir>
			<_PresentationBuildTasksProjectDir>$(MSBuildThisFileDirectory)..\Cornerstone.Presentation.BuildTasks\</_PresentationBuildTasksProjectDir>
			<_PresentationHostAppDll>$(MSBuildThisFileDirectory)..\Cornerstone.Designer.HostApp\bin\$(Configuration)\net10.0\Cornerstone.Designer.HostApp.dll</_PresentationHostAppDll>
		</PropertyGroup>
		<Error Condition="!Exists('$(_PresentationBuildTasksDir)Cornerstone.Presentation.BuildTasks.dll')" Text="Cornerstone.Presentation.BuildTasks.dll was not found at $(_PresentationBuildTasksDir). Build Cornerstone.Presentation.BuildTasks first." />
		<ItemGroup>
			<_PresentationToolsDll Include="$(_PresentationBuildTasksDir)*.dll" Exclude="$(_PresentationBuildTasksDir)Microsoft.Build.Framework.dll" />
			<_PresentationBuildFile Include="$(_PresentationNugetDir)Cornerstone.Presentation.props" />
			<_PresentationBuildFile Include="$(_PresentationNugetDir)Cornerstone.Presentation.targets" />
			<_PresentationBuildFile Include="$(_PresentationBuildTasksProjectDir)CornerstoneBuildTasks.props" />
			<_PresentationBuildFile Include="$(_PresentationBuildTasksProjectDir)CornerstoneBuildTasks.targets" />
			<_PresentationBuildFile Include="$(_PresentationBuildTasksProjectDir)CornerstoneItemSchema.xaml" />
			<_PresentationBuildFile Include="$(MSBuildThisFileDirectory)..\Cornerstone.Generators\Cornerstone.Presentation.Generators.props" />
			<_PresentationBrowserBuild Include="$(MSBuildThisFileDirectory)Platforms\Browser\build\*" />
		</ItemGroup>
		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_PresentationToolsDll)">
				<PackagePath>tools/netstandard2.0/%(Filename)%(Extension)</PackagePath>
			</TfmSpecificPackageFile>
			<!-- HostApp references Presentation, so it cannot exist on a clean first pack. -->
			<TfmSpecificPackageFile Include="$(_PresentationHostAppDll)" Condition="Exists('$(_PresentationHostAppDll)')">
				<PackagePath>tools/net10.0/designer/Cornerstone.Designer.HostApp.dll</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="@(_PresentationBuildFile)">
				<PackagePath>build/%(Filename)%(Extension);buildTransitive/%(Filename)%(Extension)</PackagePath>
			</TfmSpecificPackageFile>
			<TfmSpecificPackageFile Include="@(_PresentationBrowserBuild)">
				<PackagePath>build/%(Filename)%(Extension)</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>
</Project>
