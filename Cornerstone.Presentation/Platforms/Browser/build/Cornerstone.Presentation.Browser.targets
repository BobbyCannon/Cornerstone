<Project>
  <PropertyGroup>
    <EmccFlags Condition="'$(CornerstoneAllowWebGl2)' == 'true'">$(EmccFlags) -sUSE_WEBGL2=1 -sMAX_WEBGL_VERSION=2 -lGL </EmccFlags>
    <_AvNativeBinaryType Condition="'$(WasmEnableThreads)' == 'True'">mt</_AvNativeBinaryType>
    <_AvNativeBinaryType Condition="'$(WasmEnableThreads)' != 'True'">st</_AvNativeBinaryType>
    <WasmBuildNative Condition="'$(WasmBuildNative)' == ''">true</WasmBuildNative>
    <!--
      SourceGear SQLite (e_sqlite3.a / sqlite3.o) is compiled without wasm atomics
      or bulk-memory. WasmEnableThreads links with shared memory and wasm-ld
      rejects that object. Skia/HarfBuzz already pick mt archives above.
      no-check-features keeps multithreaded WASM; do not call SQLite from
      workers other than the thread that opened the connection.
    -->
    <EmccExtraLDFlags Condition="'$(WasmEnableThreads)' == 'true'">$(EmccExtraLDFlags) -Wl,--no-check-features</EmccExtraLDFlags>
  </PropertyGroup>

  <ItemGroup>
    <!-- So we can access Emscripten APIs -->
    <EmccExportedRuntimeMethod Include="GL" />
    <EmccExportedRuntimeMethod Include="PThread" Condition="'$(WasmEnableThreads)' == 'true'" />
  </ItemGroup>

  <!-- staticwebassets/ in a package layout, wwwroot/ in the repo. -->
  <PropertyGroup>
    <_CornerstoneBrowserJsDir Condition="Exists('$(MSBuildThisFileDirectory)../staticwebassets/cornerstone.js')">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../staticwebassets'))</_CornerstoneBrowserJsDir>
    <_CornerstoneBrowserJsDir Condition="'$(_CornerstoneBrowserJsDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../wwwroot'))</_CornerstoneBrowserJsDir>
  </PropertyGroup>

  <!-- Legacy WASM projects have no static web assets pipeline. -->
  <ItemGroup Condition="'$(UsingMicrosoftNETSdkStaticWebAssets)' != 'true'">
    <WasmExtraFilesToDeploy Include="$(_CornerstoneBrowserJsDir)**/*.*"
                            Exclude="$(_CornerstoneBrowserJsDir)cornerstone-sw.js*"
                            TargetPath="_content/Cornerstone.Presentation/%(FileName)%(Extension)" />
    <WasmExtraFilesToDeploy Include="$(_CornerstoneBrowserJsDir)cornerstone-sw.js*"
                            TargetPath="%(FileName)%(Extension)" />
  </ItemGroup>

  <!-- Revisit after https://github.com/mono/SkiaSharp/pull/2620 is merged and released. -->
  <ItemGroup Condition="'$(TargetFrameworkVersion)' != '' and '$(ShouldIncludeNativeSkiaSharp)' == 'true'">
    <NativeFileReference Include="$(SkiaSharpStaticLibraryPath)\3.1.34\$(_AvNativeBinaryType)\*.a"
                         Condition="$([MSBuild]::VersionEquals($(TargetFrameworkVersion), '8.0'))" />
    <NativeFileReference Include="$(SkiaSharpStaticLibraryPath)\3.1.56\$(_AvNativeBinaryType)\*.a"
                         Condition="$([MSBuild]::VersionGreaterThanOrEquals($(TargetFrameworkVersion), '9.0'))" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkVersion)' != '' and '$(ShouldIncludeNativeHarfBuzzSharp)' == 'True'">
    <NativeFileReference Include="$(HarfBuzzSharpStaticLibraryPath)\3.1.34\$(_AvNativeBinaryType)\*.a"
                         Condition="$([MSBuild]::VersionEquals($(TargetFrameworkVersion), '8.0'))" />
    <NativeFileReference Include="$(HarfBuzzSharpStaticLibraryPath)\3.1.56\$(_AvNativeBinaryType)\*.a"
                         Condition="$([MSBuild]::VersionGreaterThanOrEquals($(TargetFrameworkVersion), '9.0'))" />
  </ItemGroup>

  <!-- https://github.com/dotnet/runtime/issues/109289 -->
  <Target Name="Issue109289_Workaround"
          Condition="'$(DisableIssue109289Workaround)' != 'true' AND $([MSBuild]::VersionGreaterThanOrEquals($(TargetFrameworkVersion), '9.0'))"
          AfterTargets="_BrowserWasmWriteRspForLinking">
    <ItemGroup>
      <_WasmLinkStepArgs Remove="@(_EmccLinkStepArgs)" />
      <_EmccLinkStepArgs Remove="&quot;%(_WasmNativeFileForLinking.Identity)&quot;" />
      <_WasmLinkDependencies Remove="@(_WasmNativeFileForLinking)" />

      <_SkiaSharpToReorder Include="@(_WasmNativeFileForLinking)" Condition="$([System.String]::Copy('%(FullPath)').Contains('SkiaSharp'))" />
      <_WasmNativeFileForLinking Remove="@(_SkiaSharpToReorder)" />
      <_WasmNativeFileForLinking Include="@(_SkiaSharpToReorder)" />

      <_EmccLinkStepArgs Include="&quot;%(_WasmNativeFileForLinking.Identity)&quot;" />
      <_WasmLinkDependencies Include="@(_WasmNativeFileForLinking)" />
      <_WasmLinkStepArgs Include="@(_EmccLinkStepArgs)" />
    </ItemGroup>
  </Target>

  <!--
    Assets are defined in the app's build, not packed from this project.
    A hard fingerprint renames the file, which static hosting needs,
    but it does not survive `dotnet pack` on the .NET 10 SDK:
    the packed props record the resolved name and drop the marker.
    Evaluating the expression in the app keeps it intact.
    Mirrors _ResolveBlazorWasmOutputs in Microsoft.NET.Sdk.BlazorWebAssembly.
    .NET 11 fixes pack, but only for consumers on the .NET 11 SDK.
  -->
  <Target Name="_CornerstoneBrowserDefineStaticWebAssets"
          Condition="'$(UsingMicrosoftNETSdkStaticWebAssets)' == 'true'"
          AfterTargets="ResolveProjectStaticWebAssets"
          DependsOnTargets="ResolveStaticWebAssetsConfiguration;ResolveReferences">

    <PropertyGroup>
      <!--
        Re-check now that the project reference has been built.
        esbuild writes wwwroot/, so file scope evaluation cannot see it on a clean tree,
        and a staticwebassets/ left over from before that change must not win.
      -->
      <_CornerstoneBrowserJsDir Condition="Exists('$(MSBuildThisFileDirectory)../wwwroot/cornerstone.js')">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../wwwroot'))</_CornerstoneBrowserJsDir>
    </PropertyGroup>

    <!-- Design time builds do not build the project reference, so wwwroot may legitimately be absent. -->
    <Error Condition="!Exists('$(_CornerstoneBrowserJsDir)cornerstone.js') and '$(DesignTimeBuild)' != 'true'"
           Code="CSB3002"
           Text="Cornerstone browser JavaScript assets were not found in '$(_CornerstoneBrowserJsDir)'. This usually indicates a packaging error." />

    <PropertyGroup>
      <!--
        A renamed file only resolves through the import map,
        which the SDK emits only when OverrideHtmlAssetPlaceholders is on.
        Without it, keep the plain names so existing apps keep working.
      -->
      <_CornerstoneBrowserFingerprintJs Condition="'$(OverrideHtmlAssetPlaceholders)' == 'true' and '$(StaticWebAssetsFingerprintContent)' != 'false'">true</_CornerstoneBrowserFingerprintJs>
      <_CornerstoneBrowserFingerprintJs Condition="'$(_CornerstoneBrowserFingerprintJs)' == ''">false</_CornerstoneBrowserFingerprintJs>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(_CornerstoneBrowserJsDir)cornerstone.js')">
      <!-- Imported by specifier, so the import map rewrites them. -->
      <_CornerstoneBrowserFingerprintedJs Include="$(_CornerstoneBrowserJsDir)cornerstone.js;$(_CornerstoneBrowserJsDir)storage.js" />
      <!-- Loaded by URL (sourceMappingURL), which the import map does not rewrite. -->
      <_CornerstoneBrowserContentJs Include="$(_CornerstoneBrowserJsDir)cornerstone.js.map;$(_CornerstoneBrowserJsDir)storage.js.map" />
      <!--
        serviceWorker.register resolves against the document and scopes the worker to its own directory.
        The save picker polyfill looks it up with getRegistration(), which matches the document URL,
        so the worker only resolves from the app root.
      -->
      <_CornerstoneBrowserRootJs Include="$(_CornerstoneBrowserJsDir)cornerstone-sw.js;$(_CornerstoneBrowserJsDir)cornerstone-sw.js.map" />

      <!-- Separate update: %(Filename) would be a self-reference (MSB4120). -->
      <_CornerstoneBrowserFingerprintedJs>
        <RelativePath>_content/Cornerstone.Presentation/%(Filename)%(Extension)</RelativePath>
      </_CornerstoneBrowserFingerprintedJs>
      <_CornerstoneBrowserContentJs>
        <RelativePath>_content/Cornerstone.Presentation/%(Filename)%(Extension)</RelativePath>
      </_CornerstoneBrowserContentJs>
      <_CornerstoneBrowserRootJs>
        <RelativePath>%(Filename)%(Extension)</RelativePath>
      </_CornerstoneBrowserRootJs>
      <_CornerstoneBrowserPlainJs Include="@(_CornerstoneBrowserContentJs);@(_CornerstoneBrowserRootJs)" />

      <_CornerstoneBrowserJsFingerprintPattern Include="Js" Pattern="*.js" Expression="#[.{fingerprint}]!" />
    </ItemGroup>

    <DefineStaticWebAssets
      Condition="'@(_CornerstoneBrowserFingerprintedJs)' != ''"
      CandidateAssets="@(_CornerstoneBrowserFingerprintedJs)"
      FingerprintCandidates="$(_CornerstoneBrowserFingerprintJs)"
      FingerprintPatterns="@(_CornerstoneBrowserJsFingerprintPattern)"
      SourceId="$(PackageId)"
      SourceType="Computed"
      AssetKind="All"
      AssetRole="Primary"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
      ContentRoot="$(_CornerstoneBrowserJsDir)"
      BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="_CornerstoneBrowserStaticWebAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssets
      Condition="'@(_CornerstoneBrowserPlainJs)' != ''"
      CandidateAssets="@(_CornerstoneBrowserPlainJs)"
      FingerprintCandidates="false"
      SourceId="$(PackageId)"
      SourceType="Computed"
      AssetKind="All"
      AssetRole="Primary"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
      ContentRoot="$(_CornerstoneBrowserJsDir)"
      BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="_CornerstoneBrowserStaticWebAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints
      Condition="'@(_CornerstoneBrowserStaticWebAsset)' != ''"
      CandidateAssets="@(_CornerstoneBrowserStaticWebAsset)"
      ExistingEndpoints="@(StaticWebAssetEndpoint)"
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_CornerstoneBrowserStaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <ItemGroup>
      <StaticWebAsset Include="@(_CornerstoneBrowserStaticWebAsset)" />
      <StaticWebAssetEndpoint Include="@(_CornerstoneBrowserStaticWebAssetEndpoint)" />
    </ItemGroup>
  </Target>

</Project>
