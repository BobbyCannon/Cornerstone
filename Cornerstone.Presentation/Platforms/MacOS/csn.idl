[uuid(809c652e-7396-11d2-9771-00a0c9b4d50c)]
interface ICornerstoneNativeFactory : IUnknown
{
     HRESULT Initialize(ICsnGCHandleDeallocatorCallback* deallocator, ICsnApplicationEvents* appCb,
        ICsnDispatcher* dispatcher);
     ICsnMacOptions* GetMacOptions();
     HRESULT CreateTopLevel(ICsnTopLevelEvents* cb, ICsnTopLevel** ppv);
     HRESULT CreateWindow(ICsnWindowEvents* cb, ICsnWindow** ppv);
     HRESULT CreatePopup(ICsnWindowEvents* cb, ICsnPopup** ppv);
     HRESULT CreatePlatformThreadingInterface(ICsnPlatformThreadingInterface** ppv);
     HRESULT CreateStorageProvider(ICsnStorageProvider** ppv);
     HRESULT CreateScreens(ICsnScreenEvents* cb, ICsnScreens** ppv);
     HRESULT CreateClipboard(ICsnClipboard** ppv);
     HRESULT CreateCursorFactory(ICsnCursorFactory** ppv);
     HRESULT ObtainGlDisplay(ICsnGlDisplay** ppv);
     HRESULT ObtainMetalDisplay(ICsnMetalDisplay** ppv);
     HRESULT SetAppMenu(ICsnMenu* menu);
     HRESULT SetServicesMenu(ICsnMenu* menu);
     HRESULT CreateMenu(ICsnMenuEvents* cb, ICsnMenu** ppv);
     HRESULT CreateMenuItem(ICsnMenuItem** ppv);
     HRESULT CreateMenuItemSeparator(ICsnMenuItem** ppv);
     HRESULT CreateTrayIcon(ICsnTrayIcon** ppv);
     HRESULT CreateApplicationCommands(ICsnApplicationCommands** ppv);
     HRESULT CreatePlatformSettings(ICsnPlatformSettings** ppv);
     HRESULT CreatePlatformBehaviorInhibition(ICsnPlatformBehaviorInhibition** ppv);
     HRESULT CreatePlatformRenderTimer(ICsnPlatformRenderTimer** ppv);
     HRESULT ImportMTLSharedEvent([intptr]void* idMtlSharedEvent, ICsnMTLSharedEvent** ppv);
     HRESULT CreateMemoryManagementHelper(ICsnNativeObjectsMemoryManagement** ppv);
     HRESULT SetDockMenu(ICsnMenu* menu);
}

[uuid(233e094f-9b9f-44a3-9a6e-6948bbdd9fb1)]
interface ICsnString : IUnknown
{
     HRESULT Pointer(void**retOut);
     HRESULT Length(int*ret);
}

[uuid(e8cccd3e-e6dc-430a-a0b9-2ce7d7922de6)]
interface ICsnTopLevel : IUnknown
{
     HRESULT GetClientSize(CsnSize*ret);
     HRESULT GetScaling(double*ret);
     
     HRESULT Invalidate();
     
     HRESULT PointToClient(CsnPoint point, CsnPoint*ret);
     HRESULT PointToScreen(CsnPoint point, CsnPoint*ret);
     
     HRESULT SetCursor(ICsnCursor* cursor);
     HRESULT CreateGlRenderTarget(ICsnGlContext* context, ICsnGlSurfaceRenderTarget** ret);
     HRESULT CreateSoftwareRenderTarget(ICsnSoftwareRenderTarget** ret);
     HRESULT CreateMetalRenderTarget(ICsnMetalDevice* device, ICsnMetalRenderTarget** ret);
     
     HRESULT ObtainNSViewHandle([intptr]void** retOut);
     HRESULT ObtainNSViewHandleRetained([intptr]void** retOut);
     
     HRESULT CreateNativeControlHost(ICsnNativeControlHost** retOut);
     
     HRESULT GetInputMethod(ICsnTextInputMethod **ppv);
     HRESULT SetTransparencyMode(CsnWindowTransparencyMode mode);
     
     HRESULT GetCurrentDisplayId(uint* ret);

     HRESULT BeginDragAndDropOperation(
             CsnDragDropEffects effects,
             CsnPoint point,
             ICsnClipboardDataSource* source,
             ICsnDndResultCallback* callback,
             [intptr]void* sourceHandle);
}

[uuid(e5aca675-02b7-4129-aa79-d6e417210bda), cpp-virtual-inherits]
interface ICsnWindowBase : ICsnTopLevel
{
     HRESULT GetFrameSize(CsnSize*result);
     HRESULT SetFrameThemeVariant(CsnPlatformThemeVariant mode);
     HRESULT SetParent(ICsnWindowBase* parent);
     HRESULT Show(bool activate, bool isDialog);
     HRESULT Hide();
     HRESULT Close();
     HRESULT Activate(); 
     HRESULT SetMinMaxSize(CsnSize minSize, CsnSize maxSize);
     HRESULT Resize(double width, double height, CsnPlatformResizeReason reason);
     HRESULT BeginMoveDrag();
     HRESULT BeginResizeDrag(CsnWindowEdge edge);
     HRESULT GetPosition(CsnPoint*ret);
     HRESULT SetPosition(CsnPoint point);
     HRESULT SetTopMost(bool value);
     HRESULT SetMainMenu(ICsnMenu* menu);
     HRESULT ObtainNSWindowHandle([intptr]void** retOut);
     HRESULT ObtainNSWindowHandleRetained([intptr]void** retOut);
}

[uuid(83e588f3-6981-4e48-9ea0-e1e569f79a91), cpp-virtual-inherits]
interface ICsnPopup : ICsnWindowBase
{
     HRESULT SetHitTestVisible(bool value);
}

[uuid(cab661de-49d6-4ead-b59c-eac9b2b6c28d), cpp-virtual-inherits]
interface ICsnWindow : ICsnWindowBase
{
     HRESULT SetEnabled(bool enable);
     HRESULT SetCanResize(bool value);
     HRESULT SetCanMinimize(bool value);
     HRESULT SetCanMaximize(bool value);
     HRESULT SetDecorations(SystemDecorations value);
     HRESULT SetTitle(char* utf8Title);
     HRESULT SetTitleBarColor(CsnColor color);
     HRESULT SetWindowState(CsnWindowState state);
     HRESULT GetWindowState(CsnWindowState*ret);
     HRESULT TakeFocusFromChildren();
     HRESULT SetExtendClientArea(bool enable);
     HRESULT GetExtendTitleBarHeight(double*ret);
     HRESULT SetExtendTitleBarHeight(double value);
     HRESULT GetWindowZOrder(long*ret);
}

[uuid(fda9c1b3-69e0-43d7-9459-8cc97cb41f6a)]
interface ICsnTopLevelEvents : IUnknown
{
    void Closed();

    HRESULT Paint();
    void Resized([const] CsnSize& size, CsnPlatformResizeReason reason);
    void RawMouseEvent(CsnRawMouseEventType type,
                                    CsnPointerDeviceType deviceType,
                                    u_int64_t timeStamp,
                                    CsnInputModifiers modifiers,
                                    CsnPoint point,
                                    CsnVector delta,
                                    float pressure,
                                    float xTilt,
