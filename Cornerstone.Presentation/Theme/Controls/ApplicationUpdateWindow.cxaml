<Styles xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Styles.Resources>
		<ResourceDictionary>
			<ControlTheme x:Key="{x:Type ApplicationUpdateWindow}"
					TargetType="ApplicationUpdateWindow"
					BasedOn="{StaticResource {x:Type Window}}">
				<Setter Property="Width" Value="600" />
				<Setter Property="Height" Value="260" />
				<Setter Property="WindowStartupLocation" Value="CenterScreen" />
				<Setter Property="ContentTemplate">
					<DataTemplate>
						<Grid RowDefinitions="*,Auto">
							<StackPanel HorizontalAlignment="Center"
									VerticalAlignment="Center">
								<Image Source="{Binding ProductImage, RelativeSource={RelativeSource AncestorType=ApplicationUpdateWindow}}"
										Height="128"
										Width="128" />
								<TextBlock Classes="Header"
										Margin="0,20,0,0"
										Text="{Binding Status, RelativeSource={RelativeSource AncestorType=ApplicationUpdateWindow}}"
										TextAlignment="Center" />
							</StackPanel>
							<ProgressBar Grid.Row="1"
									CornerRadius="0"
									Height="4"
									Margin="0,10,0,0"
									Value="{Binding Progress, RelativeSource={RelativeSource AncestorType=ApplicationUpdateWindow}}" />
						</Grid>
					</DataTemplate>
				</Setter>
			</ControlTheme>
		</ResourceDictionary>
	</Styles.Resources>

	<Design.PreviewWith>
		<PreviewCodeSnippet MaxWidth="500">
			<ApplicationUpdateWindow />
		</PreviewCodeSnippet>
	</Design.PreviewWith>
</Styles>
