<ResourceDictionary xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:Cornerstone.Presentation.Controls.Navigation;assembly=Cornerstone.Presentation"
		x:ClassModifier="internal">

	<ControlTheme x:Key="{x:Type BreadcrumbTrail}" TargetType="BreadcrumbTrail">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="FontFamily" Value="{x:Static CornerstoneTheme.DejaVuSansLight}" />
		<Setter Property="FontSize" Value="28" />
		<Setter Property="Foreground" Value="{DynamicResource Foreground00}" />
		<Setter Property="Padding" Value="0,4" />
		<Setter Property="MinHeight" Value="44" />
		<Setter Property="Template">
			<ControlTemplate>
				<Grid ColumnDefinitions="Auto,*"
						MinHeight="{TemplateBinding MinHeight}"
						Margin="{TemplateBinding Padding}">
					<Button x:Name="PART_Ellipsis"
							Classes="Flat"
							Theme.Color="None"
							Padding="6,4"
							MinHeight="0"
							Height="NaN"
							Width="NaN"
							BorderThickness="0"
							Content="…"
							FontFamily="{TemplateBinding FontFamily}"
							FontSize="{TemplateBinding FontSize}"
							Foreground="{TemplateBinding Foreground}"
							IsVisible="{TemplateBinding HasOverflow}"
							VerticalAlignment="Top"
							ToolTip.Tip="Show hidden locations" />
					<ItemsControl Grid.Column="1"
							ItemsSource="{Binding VisibleItems, RelativeSource={RelativeSource TemplatedParent}}"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Center"
							FontFamily="{TemplateBinding FontFamily}"
							FontSize="{TemplateBinding FontSize}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel ItemSpacing="10" LineSpacing="4" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="controls:BreadcrumbSegmentView">
								<StackPanel Orientation="Horizontal" Spacing="10">
									<Path Width="14" Height="14"
											Margin="6,0,0,0"
											Stretch="Uniform"
											Opacity="0.4"
											VerticalAlignment="Center"
											Fill="{DynamicResource Foreground00}"
											Data="{StaticResource Icons.Angle.Right}"
											IsVisible="{Binding ShowSeparator}" />
									<HyperlinkButton Padding="0"
											MinHeight="0"
											Height="NaN"
											VerticalAlignment="Center"
											FontFamily="{Binding $parent[BreadcrumbTrail].FontFamily}"
											FontSize="{Binding $parent[BreadcrumbTrail].FontSize}"
											Foreground="{DynamicResource Foreground00}"
											Opacity="0.62"
											TextBlock.TextDecorations=""
											Command="{Binding $parent[BreadcrumbTrail].SelectCrumbCommand}"
											CommandParameter="{Binding Segment}"
											IsVisible="{Binding !IsCurrent}"
											Content="{Binding Title}" />
									<TextBlock VerticalAlignment="Center"
											FontFamily="{Binding $parent[BreadcrumbTrail].FontFamily}"
											FontSize="{Binding $parent[BreadcrumbTrail].FontSize}"
											Foreground="{DynamicResource Foreground00}"
											IsVisible="{Binding IsCurrent}"
											Text="{Binding Title}" />
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Grid>
			</ControlTemplate>
		</Setter>
		<Style Selector="^ /template/ HyperlinkButton:pointerover">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Foreground" Value="{DynamicResource Foreground00}" />
			<Setter Property="TextBlock.TextDecorations" Value="" />
		</Style>
	</ControlTheme>

	<Design.PreviewWith>
		<PreviewCodeSnippet>
		<Border Background="{DynamicResource Background02}" Padding="16">
			<StackPanel Spacing="16">
				<BreadcrumbTrail Width="520">
					<BreadcrumbTrail.Items>
						<controls:BreadcrumbSegment Title="This PC" Key="ThisPC" />
						<controls:BreadcrumbSegment Title="Documents" Key="Documents" ShowSeparator="True" />
						<controls:BreadcrumbSegment Title="Northwind" Key="Northwind" ShowSeparator="True" />
						<controls:BreadcrumbSegment Title="Images" Key="Images" ShowSeparator="True" />
						<controls:BreadcrumbSegment Title="Folder1" Key="Folder1" ShowSeparator="True" />
						<controls:BreadcrumbSegment Title="Folder2" Key="Folder2" ShowSeparator="True" />
						<controls:BreadcrumbSegment Title="Folder3" Key="Folder3" IsCurrent="True" ShowSeparator="True" />
					</BreadcrumbTrail.Items>
				</BreadcrumbTrail>
				<BreadcrumbTrail>
					<BreadcrumbTrail.Items>
						<controls:BreadcrumbSegment Title="Network &amp; internet" Key="Network" />
						<controls:BreadcrumbSegment Title="Wi-Fi" Key="Wi-Fi" ShowSeparator="True" />
						<controls:BreadcrumbSegment Title="Manage" Key="Manage" IsCurrent="True" ShowSeparator="True" />
					</BreadcrumbTrail.Items>
				</BreadcrumbTrail>
				<BreadcrumbTrail>
					<BreadcrumbTrail.Items>
						<controls:BreadcrumbSegment Title="Controls" Key="Controls" IsCurrent="True" />
					</BreadcrumbTrail.Items>
				</BreadcrumbTrail>
			</StackPanel>
		</Border>
		</PreviewCodeSnippet>
	</Design.PreviewWith>
</ResourceDictionary>
