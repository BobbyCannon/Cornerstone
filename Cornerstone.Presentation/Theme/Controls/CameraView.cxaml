<Styles xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Styles.Resources>
		<ResourceDictionary>
			<ControlTheme x:Key="{x:Type CameraView}" TargetType="CameraView">
				<Setter Property="Template">
					<ControlTemplate>
						<!--
							Surface only — host apps own Start/Stop preview and record chrome (all platforms).
							Keep the host laid out when not previewing (Android CameraX attach). When stopped,
							an opaque cover hides any frozen native/frame residual so stop is obvious.
						-->
						<Grid Background="Black"
								ClipToBounds="True">
							<!-- Uniform: one axis wins; aspect preserved (letterbox/pillarbox on black). -->
							<Image x:Name="PART_CameraPreview"
									Stretch="Uniform"
									StretchDirection="Both"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch" />
							<CameraNativeHost x:Name="PART_NativeHost"
									CameraAdapter="{Binding CameraAdapter, RelativeSource={RelativeSource TemplatedParent}}" />
							<!-- Covers frozen last frame (Windows Image / Android TextureView) after Stop preview. -->
							<Border Background="{DynamicResource Background02}"
									IsVisible="{Binding !IsPreviewing, RelativeSource={RelativeSource TemplatedParent}}"
									IsHitTestVisible="False" />
						</Grid>
					</ControlTemplate>
				</Setter>
			</ControlTheme>
		</ResourceDictionary>
	</Styles.Resources>

	<Design.PreviewWith>
		<PreviewCodeSnippet MaxWidth="500">
			<CameraView />
		</PreviewCodeSnippet>
	</Design.PreviewWith>
</Styles>
