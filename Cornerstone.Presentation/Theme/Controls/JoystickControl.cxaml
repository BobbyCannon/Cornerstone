<ResourceDictionary xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:converters="clr-namespace:Cornerstone.Presentation.Data.Converters;assembly=Cornerstone.Presentation">

	<converters:MultiplicationConverter x:Key="MultiplicationConverter" />
	<converters:PercentWidthConverter x:Key="PercentWidthConverter" />
	<x:Double x:Key="HalfMultiplier">0.5</x:Double>
	<x:Double x:Key="NegativeOne">-1</x:Double>

	<ControlTheme x:Key="{x:Type JoystickControl}"
			TargetType="JoystickControl">
		<Setter Property="Background" Value="{DynamicResource Background04}" />
		<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="FontFamily" Value="{x:Static CornerstoneTheme.DejaVuSansMono}" />
		<Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
		<Setter Property="Foreground" Value="{DynamicResource Foreground00}" />
		<Setter Property="Stroke" Value="{DynamicResource ThemeColor06}" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Top" />
		<Setter Property="Template">
			<ControlTemplate TargetType="JoystickControl">
				<Grid Background="{TemplateBinding Background}">
					<Border BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Padding="10">
						<Grid ColumnDefinitions="*,*"
								RowDefinitions="Auto,96">
							<StackPanel Grid.Column="0"
									Grid.ColumnSpan="2"
									Grid.Row="0">
								<TextBlock Text="{TemplateBinding Title}"
										TextAlignment="Center"
										Margin="0,0,0,10" />
							</StackPanel>
							<Border Grid.Column="0"
									Grid.ColumnSpan="2"
									Grid.Row="1"
									CornerRadius="48"
									ClipToBounds="True"
									Height="96"
									Width="96">
								<Grid>
									<Ellipse x:Name="Target"
											Fill="{DynamicResource Background05}"
											Height="96"
											Width="96" />
									<Rectangle x:Name="VerticalLine"
											Width="1"
											HorizontalAlignment="Center"
											Fill="{TemplateBinding Stroke}"
											RenderTransformOrigin="0.5,0.5"
											ClipToBounds="True">
										<Rectangle.RenderTransform>
											<TranslateTransform>
												<TranslateTransform.X>
													<MultiBinding Converter="{StaticResource MultiplicationConverter}">
														<Binding Path="HorizontalPercent" RelativeSource="{RelativeSource TemplatedParent}" />
														<Binding ElementName="Target" Path="Width" />
														<Binding Source="{StaticResource HalfMultiplier}" />
													</MultiBinding>
												</TranslateTransform.X>
											</TranslateTransform>
										</Rectangle.RenderTransform>
									</Rectangle>
									<Rectangle x:Name="HorizontalLine"
											Height="1"
											VerticalAlignment="Center"
											Fill="{TemplateBinding Stroke}"
											RenderTransformOrigin="0.5,0.5"
											ClipToBounds="True">
										<Rectangle.RenderTransform>
											<TranslateTransform>
												<TranslateTransform.Y>
													<MultiBinding Converter="{StaticResource MultiplicationConverter}">
														<Binding Path="VerticalPercent" RelativeSource="{RelativeSource TemplatedParent}" />
														<Binding ElementName="Target" Path="Height" />
														<Binding Source="{StaticResource HalfMultiplier}" />
														<Binding Source="{StaticResource NegativeOne}" />
													</MultiBinding>
												</TranslateTransform.Y>
											</TranslateTransform>
										</Rectangle.RenderTransform>
									</Rectangle>
									<Ellipse x:Name="Center"
											Fill="{TemplateBinding Dot}"
											Height="6"
											Width="6"
											Margin="0">
										<Ellipse.RenderTransform>
											<TranslateTransform>
												<TranslateTransform.X>
													<MultiBinding Converter="{StaticResource MultiplicationConverter}">
														<Binding Path="HorizontalPercent" RelativeSource="{RelativeSource TemplatedParent}" />
														<Binding ElementName="Target" Path="Width" />
														<Binding Source="{StaticResource HalfMultiplier}" />
													</MultiBinding>
												</TranslateTransform.X>
												<TranslateTransform.Y>
													<MultiBinding Converter="{StaticResource MultiplicationConverter}">
														<Binding Path="VerticalPercent" RelativeSource="{RelativeSource TemplatedParent}" />
														<Binding ElementName="Target" Path="Width" />
														<Binding Source="{StaticResource HalfMultiplier}" />
														<Binding Source="{StaticResource NegativeOne}" />
													</MultiBinding>
												</TranslateTransform.Y>
											</TranslateTransform>
										</Ellipse.RenderTransform>
									</Ellipse>
									<Ellipse x:Name="Deadzone"
											Stroke="{DynamicResource Background08}"
											StrokeThickness="1"
											HorizontalAlignment="Center"
											VerticalAlignment="Center">
										<Ellipse.Height>
											<MultiBinding Converter="{StaticResource PercentWidthConverter}">
												<Binding Path="DeadZonePercent" RelativeSource="{RelativeSource TemplatedParent}" />
												<Binding ElementName="Target" Path="Height" />
											</MultiBinding>
										</Ellipse.Height>
										<Ellipse.Width>
											<MultiBinding Converter="{StaticResource PercentWidthConverter}">
												<Binding Path="DeadZonePercent" RelativeSource="{RelativeSource TemplatedParent}" />
												<Binding ElementName="Target" Path="Width" />
											</MultiBinding>
										</Ellipse.Width>
									</Ellipse>
								</Grid>
							</Border>
							<Grid Grid.Column="0"
									Grid.ColumnSpan="2"
									Grid.Row="1"
									Height="96"
									Width="96">
								<ToggleButton IsChecked="{TemplateBinding ButtonLeft, Mode=OneWay}"
										IsHitTestVisible="False"
										Margin="-96,0,0,0"
										Height="9"
										Width="9" />
								<ToggleButton IsChecked="{TemplateBinding ButtonRight, Mode=OneWay}"
										IsHitTestVisible="False"
										Margin="96,0,0,0"
										Height="9"
										Width="9" />
								<ToggleButton IsChecked="{TemplateBinding ButtonUp, Mode=OneWay}"
										IsHitTestVisible="False"
										Margin="0,-95,0,0"
										Height="9"
										Width="9" />
								<ToggleButton IsChecked="{TemplateBinding ButtonDown, Mode=OneWay}"
										IsHitTestVisible="False"
										Margin="0,95,0,0"
										Height="9"
										Width="9" />
							</Grid>
						</Grid>
					</Border>
				</Grid>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<Design.PreviewWith>
		<PreviewCodeSnippet Width="600">
			<StackPanel Orientation="Horizontal"
					HorizontalAlignment="Left"
					Spacing="10"
					Margin="20">
				<JoystickControl
						x:Name="Joystick"
						DeadZonePercent="0.15"
						Title="Control"
						HorizontalPercent="0"
						VerticalPercent="0" />
				<StackPanel Spacing="20" Margin="20">
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Slider Value="{Binding #Joystick.HorizontalPercent, Mode=TwoWay}"
								Maximum="1"
								Minimum="-1"
								Width="160" />
						<TextBlock Text="{Binding #Joystick.HorizontalPercent}" Width="34" />
						<TextBlock Text="X" />
					</StackPanel>
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Slider Value="{Binding #Joystick.VerticalPercent, Mode=TwoWay}"
								Maximum="1"
								Minimum="-1"
								Width="160" />
						<TextBlock Text="{Binding #Joystick.VerticalPercent}" Width="34" />
						<TextBlock Text="Y" />
					</StackPanel>
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Slider Value="{Binding #Joystick.DeadZonePercent, Mode=TwoWay}"
								Maximum="0.5"
								Minimum="0"
								Width="160" />
						<TextBlock Text="{Binding #Joystick.DeadZonePercent}" Width="34" />
						<TextBlock Text="Deadzone" />
					</StackPanel>
				</StackPanel>
			</StackPanel>
		</PreviewCodeSnippet>
	</Design.PreviewWith>
</ResourceDictionary>
