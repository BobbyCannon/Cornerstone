<ResourceDictionary
		xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:ClassModifier="internal">

	<!-- Button control theme. -->

	<ControlTheme
			x:Key="{x:Type RefreshContainer}"
			TargetType="RefreshContainer">

		<!-- Template. -->

		<Setter Property="Template">

			<ControlTemplate>

				<!-- Stacking grid. -->

				<Grid>

					<!-- Content. -->

					<ContentPresenter
							Name="PART_ContentPresenter"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							Content="{TemplateBinding Content}"
							Padding="{TemplateBinding Padding}"
							VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
							HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />

					<!-- Visualizer presenter. -->

					<Grid Name="PART_RefreshVisualizerPresenter" />

				</Grid>

			</ControlTemplate>

		</Setter>

	</ControlTheme>
	<Design.PreviewWith>
		<PreviewCodeSnippet MaxWidth="400">
			<RefreshContainer Width="280" Height="80">
				<Border Background="{DynamicResource Background03}" Padding="16">
					<TextBlock Text="Pull to refresh" />
				</Border>
			</RefreshContainer>
		</PreviewCodeSnippet>
	</Design.PreviewWith>
</ResourceDictionary>