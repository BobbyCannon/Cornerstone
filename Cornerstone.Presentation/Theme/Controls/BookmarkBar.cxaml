<Styles xmlns="https://github.com/BobbyCannon/Cornerstone"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style Selector="BookmarkBarItem">
		<!-- Direct Panel child so flyout rows, which are nested BookmarkBarItems, do not match. -->
		<Style Selector="^ > Panel > Border#PART_Header">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="^:open > Panel > Border#PART_Header">
			<Setter Property="Background" Value="{DynamicResource Background07}" />
		</Style>
		<Style Selector="^ > Panel > Border#PART_Header:pointerover">
			<Setter Property="Background" Value="{DynamicResource Background07}" />
		</Style>
		<Style Selector="^:pointerover > Panel > Border#PART_Header">
			<Setter Property="Background" Value="{DynamicResource Background07}" />
		</Style>
		<Style Selector="^:drop-into > Panel > Border#PART_Header">
			<Setter Property="Background" Value="{DynamicResource Background07}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeColor05}" />
			<Setter Property="BorderThickness" Value="2" />
		</Style>
		<Style Selector="^:nested:folder > Panel > Border#PART_Header Path#PART_FolderArrow">
			<Setter Property="IsVisible" Value="True" />
		</Style>
	</Style>
</Styles>
